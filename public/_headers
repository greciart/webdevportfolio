# Astro fingerprints everything under /_astro/, so the filename changes whenever
# the contents do. That makes it safe to cache forever, which is the whole point
# of moving the stylesheet out of the HTML: it is downloaded on the first page
# and read from disk on every page after it.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=2592000

# Los feeds (/rss.xml, /es/rss.xml) NO llevan X-Robots-Tag: noindex a proposito.
# Google nunca indexa un feed como pagina de todas formas; con noindex, Search
# Console abria una categoria aparte ("Excluida por noindex") y mandaba un correo
# de "nuevo motivo" cada vez que reaparecia. Sin el header el feed cae en
# "Rastreada: actualmente sin indexar", que ya existe y no genera avisos.
