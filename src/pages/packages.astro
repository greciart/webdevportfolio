---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/ui/Heading.astro";
import Button from "../components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { packagesCopy } from "../i18n/packages";
import { getLangFromUrl, localizePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const c = packagesCopy[lang];
const p = (path: string) => localizePath(path, lang);

const { pageTitle, description } = c;

// Same tokens as the extras page, so the two read as one site.
const cardBorder =
  "relative rounded-2xl bg-linear-to-br from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 p-[2px] transition-all duration-500 hover:shadow-[0_10px_50px_rgba(13,188,130,0.2)]";
const cardInner =
  "h-full rounded-[calc(1rem-1px)] bg-white p-7 max-sm:p-5 dark:bg-zinc-900/80";
const eyebrow =
  "inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-600 dark:text-mint-300";
const bodyText =
  "text-base max-md:text-sm font-normal leading-7 text-blacktext/80 dark:text-gray-300";
const chip =
  "rounded-full border border-mint-200 bg-mint-50 px-3 py-1.5 text-xs font-semibold text-mint-700 dark:border-mint-800/50 dark:bg-mint-900/30 dark:text-mint-300";
const sectionWrap = "scroll-m-24 px-8 py-16 max-sm:px-4 max-sm:py-10";
---

<Layout pageTitle={pageTitle} description={description}>
  <!-- ===================== HERO ===================== -->
  <section class="relative px-8 pb-8 pt-16 max-sm:px-4 max-sm:pt-10">
    <div class="blur-circle"></div>
    <div
      data-reveal="sharpen"
      class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center"
    >
      <span class={eyebrow}>
        {c.heroEyebrow}
      </span>

      <Heading text={c.heroTitle} textGradient={c.heroTitleAccent} level={1} />

      <p class={`${bodyText} max-w-2xl`}>{c.heroIntro}</p>

      <p
        class="max-w-2xl rounded-2xl border border-mint-100 bg-white/70 px-6 py-4 text-sm font-normal leading-6 text-blacktext/70 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-400 max-sm:px-4"
      >
        {c.heroNote}
      </p>
    </div>
  </section>

  <!-- ===================== TIERS ===================== -->
  <section id="tiers" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header data-reveal="blur" class="flex flex-col gap-4">
        <Heading text={c.tiersTitle} textGradient={c.tiersTitleAccent} level={2} />
        <p class={bodyText}>{c.tiersIntro}</p>
      </header>

      <div
        data-reveal-stagger="up"
        class="grid grid-cols-4 gap-6 max-xl:grid-cols-2 max-md:grid-cols-1"
      >
        {
          c.tiers.map((tier) => (
            <article class={`${cardBorder} ${tier.featured ? "xl:-mt-2 xl:mb-2" : ""}`}>
              {tier.featured && (
                /* Same corner ribbon geometry as the extras page: the band's
                   centre has to sit on the corner bisector, x + y = 98. */
                <div class="pointer-events-none absolute right-0 top-0 z-10 h-[98px] w-[98px] overflow-hidden rounded-tr-2xl">
                  <span class="absolute right-[-38px] top-[26px] w-[150px] rotate-45 bg-linear-to-r from-riptide-400 to-mint-500 py-1 text-center text-[9px] font-bold uppercase tracking-widest text-blacktext shadow-md">
                    {c.ribbon}
                  </span>
                </div>
              )}

              <div class={`${cardInner} flex flex-col gap-4`}>
                <span class="text-xs font-bold uppercase tracking-widest text-mint-600 dark:text-mint-300">
                  {c.tierLabel} {tier.step}
                </span>

                <div class="flex flex-col">
                  <h3 class="text-xl font-bold text-blacktext dark:text-white">{tier.name}</h3>
                  <span
                    class="my-3.5 h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500"
                    aria-hidden="true"
                  />
                  <p class="text-xs font-semibold uppercase tracking-wider text-blacktext/50 dark:text-zinc-500">
                    {tier.stack}
                  </p>
                </div>

                <p class="text-sm font-semibold leading-6 text-mint-700 dark:text-mint-300">
                  {tier.tagline}
                </p>

                <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                  {tier.description}
                </p>

                <div class="flex flex-col gap-1.5">
                  <span class="text-[10px] font-bold uppercase tracking-widest text-blacktext/40 dark:text-zinc-500">
                    {c.bestForLabel}
                  </span>
                  <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                    {tier.bestFor}
                  </p>
                </div>

                <div class="mt-auto flex flex-col gap-2 pt-2">
                  <span class="text-[10px] font-bold uppercase tracking-widest text-blacktext/40 dark:text-zinc-500">
                    {c.includesLabel}
                  </span>
                  <ul class="flex flex-col gap-2">
                    {tier.includes.map((item) => (
                      <li class="flex items-start gap-2.5 text-sm font-normal leading-6 text-blacktext/80 dark:text-zinc-300">
                        <span
                          class="mt-2 size-1.5 shrink-0 rotate-45 bg-riptide-400"
                          aria-hidden="true"
                        />
                        {item}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== INCLUDED IN EVERY PROJECT ===================== -->
  <section id="included" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header data-reveal="blur-up" class="flex flex-col gap-4">
        <div class="flex items-center gap-4">
          <Icon class="text-3xl text-mint-500 dark:text-white" name="rocket" aria-hidden="true" />
          <Heading text={c.includedTitle} textGradient={c.includedTitleAccent} level={2} />
        </div>
        <p class={bodyText}>{c.includedIntro}</p>
      </header>

      <div
        data-reveal-stagger="scale"
        class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1"
      >
        {
          c.included.map((item) => (
            <article class={cardBorder}>
              <div class={`${cardInner} flex flex-col gap-3`}>
                {item.icon && (
                  <span class="flex size-11 items-center justify-center rounded-xl border border-mint-200 bg-mint-50 text-mint-600 dark:border-mint-800/50 dark:bg-mint-900/30 dark:text-mint-300">
                    <Icon class="size-5" name={item.icon} aria-hidden="true" />
                  </span>
                )}
                <h3 class="text-lg font-bold text-blacktext dark:text-white">{item.name}</h3>
                <span
                  class="h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500"
                  aria-hidden="true"
                />
                <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== WHAT MOVES THE PRICE ===================== -->
  <section id="scale" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header data-reveal="blur" class="flex flex-col gap-4">
        <Heading text={c.scaleTitle} textGradient={c.scaleTitleAccent} level={2} />
        <p class={`${bodyText} max-w-3xl`}>{c.scaleIntro}</p>
      </header>

      <div
        data-reveal-stagger="up"
        class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1"
      >
        {
          c.scaleFactors.map((item) => (
            <div class="rounded-2xl border border-mint-100 bg-white/70 p-6 transition-colors hover:border-mint-300 dark:border-zinc-800 dark:bg-zinc-900/50 dark:hover:border-mint-700 max-sm:p-5">
              <h3 class="text-base font-bold text-blacktext dark:text-white">{item.name}</h3>
              <p class="mt-2 text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                {item.description}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== EXTRAS (NOT INCLUDED) ===================== -->
  <section id="extras" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header data-reveal="blur-up" class="flex flex-col gap-4">
        <Heading text={c.extrasTitle} textGradient={c.extrasTitleAccent} level={2} />
        <p class={`${bodyText} max-w-3xl`}>{c.extrasIntro}</p>
      </header>

      <!-- Cards on small screens, table from lg up: a four column table of
           prose is unreadable on a phone. -->
      <div data-reveal-stagger="scale" class="grid gap-4 lg:hidden">
        {
          c.extras.map((extra) => (
            <div class="rounded-2xl border border-mint-100 bg-white/70 p-5 dark:border-zinc-800 dark:bg-zinc-900/50">
              <div class="flex items-start justify-between gap-4">
                <h3 class="text-base font-bold text-blacktext dark:text-white">{extra.name}</h3>
                <span class={`${chip} shrink-0`}>{extra.price}</span>
              </div>
              <p class="mt-2 text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                {extra.description}
              </p>
              <p class="mt-3 text-[10px] font-bold uppercase tracking-widest text-blacktext/40 dark:text-zinc-500">
                {c.extrasDaysLabel}: {extra.days}
              </p>
            </div>
          ))
        }
      </div>

      <div data-reveal="up" class="max-lg:hidden">
        <div
          class="overflow-hidden rounded-2xl border border-mint-100 dark:border-zinc-800"
        >
          <table class="w-full border-collapse text-left">
            <thead class="bg-linear-to-r from-riptide-400 to-mint-500">
              <tr>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-blacktext">
                  {c.extrasNameLabel}
                </th>
                <th class="px-6 py-4 text-xs font-bold uppercase tracking-widest text-blacktext">
                  {c.extrasWhatLabel}
                </th>
                <th class="whitespace-nowrap px-6 py-4 text-xs font-bold uppercase tracking-widest text-blacktext">
                  {c.extrasPriceLabel}
                </th>
                <th class="whitespace-nowrap px-6 py-4 text-xs font-bold uppercase tracking-widest text-blacktext">
                  {c.extrasDaysLabel}
                </th>
              </tr>
            </thead>
            <tbody>
              {
                c.extras.map((extra, i) => (
                  <tr
                    class={
                      i % 2 === 0
                        ? "bg-white/70 dark:bg-zinc-900/50"
                        : "bg-mint-50/40 dark:bg-zinc-900/80"
                    }
                  >
                    <td class="px-6 py-4 align-top text-sm font-bold text-blacktext dark:text-white">
                      {extra.name}
                    </td>
                    <td class="px-6 py-4 align-top text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                      {extra.description}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 align-top text-sm font-bold text-mint-700 dark:text-mint-300">
                      {extra.price}
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 align-top text-sm font-semibold text-blacktext/60 dark:text-zinc-400">
                      {extra.days}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <p
        data-reveal="fade"
        class="max-w-3xl text-sm font-normal leading-6 text-blacktext/60 dark:text-zinc-400"
      >
        {c.extrasFootnote}
      </p>
    </div>
  </section>

  <!-- ===================== WHAT I NEED FROM YOU ===================== -->
  <section id="requirements" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header data-reveal="blur" class="flex flex-col gap-4">
        <div class="flex items-center gap-4">
          <Icon
            class="text-3xl text-mint-500 dark:text-white"
            name="briefcase"
            aria-hidden="true"
          />
          <Heading text={c.needTitle} textGradient={c.needTitleAccent} level={2} />
        </div>
        <p class={`${bodyText} max-w-3xl`}>{c.needIntro}</p>
      </header>

      <ol
        data-reveal-stagger="up"
        class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1"
      >
        {
          c.needFromYou.map((item, i) => (
            <li class={cardBorder}>
              <div class={`${cardInner} flex flex-col gap-3`}>
                <div class="flex items-center gap-3">
                  {item.icon && (
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl border border-mint-200 bg-mint-50 text-mint-600 dark:border-mint-800/50 dark:bg-mint-900/30 dark:text-mint-300">
                      <Icon class="size-5" name={item.icon} aria-hidden="true" />
                    </span>
                  )}
                  <span class="text-xs font-bold text-mint-600 dark:text-mint-300">
                    {String(i + 1).padStart(2, "0")}
                  </span>
                </div>
                <h3 class="text-base font-bold text-blacktext dark:text-white">{item.name}</h3>
                <span
                  class="h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500"
                  aria-hidden="true"
                />
                <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                  {item.description}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <div
        data-reveal="up"
        class="rounded-2xl border border-mint-100 bg-white/70 p-7 dark:border-zinc-800 dark:bg-zinc-900/50 max-sm:p-5"
      >
        <span class="text-xs font-bold uppercase tracking-widest text-mint-600 dark:text-mint-300">
          {c.needMustHaveLabel}
        </span>
        <ul class="mt-4 flex flex-col gap-2">
          {
            c.needMustHave.map((item) => (
              <li class="flex items-start gap-2.5 text-sm font-normal leading-6 text-blacktext/80 dark:text-zinc-300">
                <span
                  class="mt-2 size-1.5 shrink-0 rotate-45 bg-riptide-400"
                  aria-hidden="true"
                />
                {item}
              </li>
            ))
          }
        </ul>
      </div>

      <p
        data-reveal="fade"
        class="max-w-3xl text-sm font-normal leading-6 text-blacktext/60 dark:text-zinc-400"
      >
        {c.needNote}
      </p>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="px-8 pb-20 max-sm:px-4 max-sm:pb-12">
    <div
      data-reveal="scale"
      class="mx-auto max-w-5xl rounded-2xl bg-linear-to-r from-mint-300 to-mint-50 p-[2px] dark:from-mint-600 dark:to-mint-200/5"
    >
      <div
        class="flex items-center justify-between gap-8 rounded-[calc(1rem-1px)] bg-linear-to-tr from-riptide-100 to-white px-10 py-12 dark:from-mint-950 dark:to-zinc-950 max-sm:flex-col max-sm:px-6 max-sm:py-8 max-sm:text-center"
      >
        <div class="flex max-w-lg flex-col gap-3">
          <Heading text={c.ctaTitle} textGradient={c.ctaTitleAccent} level={2} />
          <p class="text-sm font-normal leading-6 text-blacktext/80 dark:text-gray-300">
            {c.ctaCopy}
          </p>
        </div>
        <div class="flex shrink-0 gap-4 max-sm:flex-col max-sm:items-center">
          <Button link={p("/contact")} text={c.ctaButton} iconName="envelope" variant="small" />
          <Button link={p("/#projects")} text={c.ctaSecondary} iconName="code" variant="smalldark" />
        </div>
      </div>
    </div>
  </section>
</Layout>
