---
import Layout from "../../../layouts/Layout.astro";
import BlogPost from "../../../components/blog/BlogPost.astro";
import Heading from "../../../components/ui/Heading.astro";
import { toSlug } from "../../../i18n/utils";

export async function getStaticPaths() {
  const modules = import.meta.glob<any>("../posts/*.md", { eager: true });
  const allPosts = Object.values(modules);

  const uniqueTechs: string[] = [
    ...new Set(allPosts.map((post: any) => post.frontmatter.languages).flat()),
  ];

  // Labels like `AI` and `LLM` are uppercase, which meant the only valid URL
  // was `/blog/techs/AI/` while every crawler and every hand-typed link tried
  // the lowercase form. The slug is the address; the label is a prop.
  return uniqueTechs.map((category) => {
    const filteredPosts = allPosts.filter((post: any) =>
      post.frontmatter.languages.includes(category)
    );
    return {
      params: { category: toSlug(category) },
      props: { posts: filteredPosts, label: category },
    };
  });
}

const { posts, label } = Astro.props;
---

<Layout
  pageTitle={`Posts about ${label} | Grecia V.`}
  description={`Every article about ${label} on the blog of Grecia V., web designer and frontend developer.`}
>
  <section class="py-8">
    <div class="flex flex-col gap-8 max-w-4xl mx-auto">
      <Heading text="Posts about" textGradient={label} />

      {
        posts.map((post) => (
          <BlogPost
            url={post.url}
            title={post.frontmatter.title}
            date={post.frontmatter.pubDate}
            tags={post.frontmatter.tags}
            languages={post.frontmatter.languages}
            image={post.frontmatter.image}
          />
        ))
      }
    </div>
  </section>
</Layout>
