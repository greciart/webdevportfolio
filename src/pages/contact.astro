---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/ui/Heading.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { contactCopy } from "../i18n/contact";
import { getLangFromUrl } from "../i18n/utils";

const [staticData] = await getCollection("staticData");
const {
  email,
  github,
  githubIconName,
  linkedin,
  linkedinIconName,
  contra,
  contraIconName,
  behance,
  behanceIconName,
  calendly,
} = staticData.data;

// Set PUBLIC_RECAPTCHA_SITE_KEY (plus SITE_RECAPTCHA_KEY / SITE_RECAPTCHA_SECRET
// on Netlify) to switch the captcha on. Left empty, the form keeps working with
// the honeypot and the client-side traps only — nothing breaks.
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? "";

const lang = getLangFromUrl(Astro.url);
const c = contactCopy[lang];

const { pageTitle, description } = c;
const services = c.services;
const budgets = c.budgets;

const channels = [
  {
    icon: "envelope",
    label: "Email",
    value: email,
    href: `mailto:${email}`,
  },
  {
    icon: "linkedin",
    label: "LinkedIn",
    value: "grecia-valentina-valero",
    href: linkedin,
  },
  {
    icon: behanceIconName,
    label: "Behance",
    value: "greciavalero",
    href: behance,
  },
  {
    icon: githubIconName,
    label: "GitHub",
    value: "GVPV12",
    href: github,
  },
  {
    icon: contraIconName,
    label: "Contra",
    value: "greciavalentina_",
    href: contra,
  },
];

const field =
  "w-full rounded-xl border border-mint-200 bg-white px-4 py-3 text-sm font-normal text-blacktext outline-none transition-all placeholder:text-blacktext/35 focus:border-mint-400 focus:ring-2 focus:ring-mint-400/30 dark:border-zinc-700 dark:bg-zinc-900 dark:text-gray-100 dark:placeholder:text-zinc-600 dark:focus:border-mint-500";
const labelCls =
  "text-xs font-semibold uppercase tracking-widest text-blacktext/60 dark:text-zinc-400";
const eyebrow =
  "inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-600 dark:text-mint-300";
---

<Layout pageTitle={pageTitle} description={description}>
  <section class="relative px-8 pb-8 pt-16 max-sm:px-4 max-sm:pt-10">
    <div class="blur-circle"></div>
    <div data-reveal="sharpen" class="mx-auto flex max-w-3xl flex-col items-center gap-5 text-center">
      <span class={eyebrow}>
        <span class="h-px w-8 bg-mint-400"></span>
        {c.eyebrow}
        <span class="h-px w-8 bg-mint-400"></span>
      </span>

      <Heading text={c.title} textGradient={c.titleAccent} level={1} />

      <p class="max-w-xl text-base font-normal leading-7 text-blacktext/80 dark:text-gray-300 max-md:text-sm">
        {c.intro}
      </p>

      <span
        class="inline-flex items-center gap-2 rounded-full border border-mint-200 bg-mint-50 px-4 py-1.5 text-xs font-semibold text-mint-700 dark:border-mint-800/50 dark:bg-mint-900/30 dark:text-mint-300"
      >
        <span
          class="size-1.5 animate-pulse rounded-full bg-green-400 shadow-[0px_0px_0px_3px_rgba(34,197,94,0.4)]"
          aria-hidden="true"></span>
        {c.availability}
      </span>
    </div>
  </section>

  <section class="px-8 pb-20 pt-8 max-sm:px-4 max-sm:pb-12">
    <div class="mx-auto grid max-w-7xl grid-cols-[1.6fr_1fr] items-start gap-8 max-lg:grid-cols-1">
      <!-- ===================== FORM ===================== -->
      <div
        data-reveal="blur-up"
        class="rounded-2xl bg-linear-to-br from-mint-300 to-mint-50 p-[2px] dark:from-mint-600 dark:to-mint-200/5"
      >
        <div
          class="rounded-[calc(1rem-1px)] bg-white p-9 max-sm:p-5 dark:bg-zinc-900/90"
        >
          <h2 class="mb-1 text-2xl font-bold text-blacktext dark:text-white max-sm:text-xl">
            {c.formTitle}
          </h2>
          <p class="mb-7 text-sm font-normal text-blacktext/60 dark:text-zinc-400">
            {c.requiredNote[0]}<span class="text-mint-500">*</span>{c.requiredNote[1]}
          </p>

          <form
            id="contact-form"
            name="contact"
            method="POST"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            data-netlify-recaptcha={recaptchaSiteKey ? "true" : undefined}
            data-msg-fast={c.errorTooFast}
            data-msg-captcha={c.errorCaptcha}
            data-msg-error={c.errorGeneric}
            data-msg-sending={c.submitting}
            class="flex flex-col gap-5"
          >
            <input type="hidden" name="form-name" value="contact" />

            {/* Honeypot: Netlify drops the submission server-side if it is filled. */}
            <p class="hidden">
              <label>
                {c.honeypot} <input name="bot-field" />
              </label>
            </p>

            {/* Traps filled by JS. A script-less bot leaves them empty and a
                script-driven one submits far too fast to look human. */}
            <input type="hidden" name="filled-in" value="" />
            <input type="hidden" name="seconds-on-form" value="" />

            <div class="grid grid-cols-2 gap-5 max-sm:grid-cols-1">
              <div class="flex flex-col gap-2">
                <label class={labelCls} for="name">
                  {c.labelName} <span class="text-mint-500">*</span>
                </label>
                <input
                  class={field}
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  placeholder={c.placeholderName}
                />
              </div>

              <div class="flex flex-col gap-2">
                <label class={labelCls} for="email">
                  {c.labelEmail} <span class="text-mint-500">*</span>
                </label>
                <input
                  class={field}
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder={c.placeholderEmail}
                />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-5 max-sm:grid-cols-1">
              <div class="flex flex-col gap-2">
                <label class={labelCls} for="service">{c.labelService}</label>
                <select class={field} id="service" name="service">
                  <option value="">{c.servicePlaceholder}</option>
                  {services.map((service) => <option value={service}>{service}</option>)}
                </select>
              </div>

              <div class="flex flex-col gap-2">
                <label class={labelCls} for="budget">{c.labelBudget}</label>
                <select class={field} id="budget" name="budget">
                  <option value="">{c.budgetPlaceholder}</option>
                  {budgets.map((budget) => <option value={budget}>{budget}</option>)}
                </select>
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label class={labelCls} for="message">
                {c.labelMessage} <span class="text-mint-500">*</span>
              </label>
              <textarea
                class={`${field} min-h-40 resize-y leading-6`}
                id="message"
                name="message"
                required
                placeholder={c.placeholderMessage}
              ></textarea>
            </div>

            {
              recaptchaSiteKey && (
                /* The 78px reservation keeps CLS at zero when the widget mounts. */
                <div
                  id="recaptcha-slot"
                  data-sitekey={recaptchaSiteKey}
                  class="min-h-[78px]"
                />
              )
            }

            <div class="mt-1 flex items-center justify-between gap-4 max-sm:flex-col max-sm:items-stretch">
              <button
                type="submit"
                id="contact-submit"
                class="inline-flex w-fit cursor-pointer items-center justify-center gap-2 rounded-full bg-linear-to-r from-riptide-300 to-mint-300 px-8 py-4 text-base font-medium text-blacktext transition-all hover:scale-105 hover:bg-linear-to-l hover:shadow-lg hover:shadow-mint-500/30 disabled:cursor-not-allowed disabled:opacity-60 disabled:hover:scale-100 dark:from-riptide-500 dark:to-mint-500 dark:text-mint-50 max-sm:w-full max-sm:py-3 max-sm:text-sm"
              >
                <Icon name="paperplane" class="size-5" aria-hidden="true" />
                <span id="contact-submit-text">{c.submit}</span>
              </button>

              <p class="text-xs font-normal text-blacktext/50 dark:text-zinc-500 max-sm:text-center">
                {c.orWrite}
                <a
                  href={`mailto:${email}`}
                  class="font-semibold text-mint-600 underline underline-offset-4 dark:text-mint-300"
                  >{email}</a
                >
              </p>
            </div>

            <p
              id="contact-error"
              class="hidden rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-normal text-red-700 dark:border-red-900/60 dark:bg-red-950/40 dark:text-red-300"
              role="alert"
            >
            </p>
          </form>

          <!-- Success state, swapped in after a successful submit -->
          <div id="contact-success" class="hidden flex-col items-center gap-4 py-12 text-center">
            <span
              class="flex size-14 items-center justify-center rounded-full bg-linear-to-br from-riptide-400 to-mint-500 text-blacktext"
              aria-hidden="true"
            >
              <svg class="size-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path d="m5 13 4 4L19 7" />
              </svg>
            </span>
            <h3 class="text-2xl font-bold text-blacktext dark:text-white">
              {c.successTitle}
            </h3>
            <p class="max-w-md text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
              {c.successCopy}
            </p>
            <a
              href={calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-2 inline-flex items-center gap-2 rounded-full bg-linear-to-r from-riptide-400 to-mint-500 px-6 py-3 text-sm font-semibold text-blacktext transition-transform hover:scale-105"
            >
              {c.bookCall}
            </a>
          </div>
        </div>
      </div>

      <!-- ===================== SIDEBAR ===================== -->
      <aside data-reveal-stagger="up" class="flex flex-col gap-6">
        <div
          class="rounded-2xl bg-linear-to-br from-mint-300 to-mint-50 p-[2px] dark:from-mint-600 dark:to-mint-200/5"
        >
          <div
            class="flex flex-col gap-5 rounded-[calc(1rem-1px)] bg-linear-to-tr from-riptide-100 to-white p-7 max-sm:p-5 dark:from-mint-950 dark:to-zinc-950"
          >
            <h2 class="text-lg font-bold text-blacktext dark:text-white">
              {c.callTitle}
            </h2>
            <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-300">
              {c.callCopy}
            </p>
            <a
              href={calendly}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex w-fit items-center gap-2 rounded-full bg-linear-to-r from-riptide-400 to-mint-500 px-6 py-3 text-sm font-semibold text-blacktext transition-transform hover:scale-105"
            >
              {c.bookCall}
            </a>
          </div>
        </div>

        <div
          class="flex flex-col gap-1 rounded-2xl border border-mint-100 bg-white/70 p-5 dark:border-zinc-800 dark:bg-zinc-900/50"
        >
          <h2 class="mb-3 px-2 text-xs font-semibold uppercase tracking-widest text-blacktext/60 dark:text-zinc-400">
            {c.elsewhere}
          </h2>
          {
            channels.map((channel) => (
              <a
                href={channel.href}
                target={channel.href.startsWith("mailto:") ? undefined : "_blank"}
                rel="noopener noreferrer"
                class="group flex items-center gap-4 rounded-xl px-3 py-3 transition-colors hover:bg-mint-50 dark:hover:bg-zinc-800/70"
              >
                <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-mint-100 text-mint-600 transition-colors group-hover:bg-mint-500 group-hover:text-white dark:bg-zinc-800 dark:text-mint-300 dark:group-hover:bg-mint-500 dark:group-hover:text-blacktext">
                  <Icon name={channel.icon} class="size-4" aria-hidden="true" />
                </span>
                <span class="flex min-w-0 flex-col">
                  <span class="text-xs font-semibold uppercase tracking-wider text-blacktext/50 dark:text-zinc-500">
                    {channel.label}
                  </span>
                  <span class="truncate text-sm font-semibold text-blacktext dark:text-gray-200">
                    {channel.value}
                  </span>
                </span>
              </a>
            ))
          }
        </div>

        <div
          class="flex flex-col gap-4 rounded-2xl border border-mint-100 bg-white/70 p-6 dark:border-zinc-800 dark:bg-zinc-900/50"
        >
          {
            c.facts.map((item) => (
              <div class="flex items-start gap-3">
                <span
                  class="mt-1.5 size-1.5 shrink-0 rotate-45 bg-linear-to-br from-riptide-400 to-mint-500"
                  aria-hidden="true"
                />
                <div class="flex flex-col gap-0.5">
                  <span class="text-sm font-bold text-blacktext dark:text-white">
                    {item.title}
                  </span>
                  <span class="text-xs font-normal leading-5 text-blacktext/60 dark:text-zinc-400">
                    {item.text}
                  </span>
                </div>
              </div>
            ))
          }
        </div>
      </aside>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const success = document.getElementById("contact-success");
  const errorBox = document.getElementById("contact-error");
  const submit = document.getElementById("contact-submit") as HTMLButtonElement | null;
  const submitText = document.getElementById("contact-submit-text");

  if (form && success && errorBox && submit && submitText) {
    const idleText = submitText.textContent ?? "";
    const openedAt = Date.now();

    function showError(message: string) {
      errorBox!.textContent = message;
      errorBox!.classList.remove("hidden");
    }

    // --- Trap 1: prove a browser actually rendered and touched the form ---
    const filledIn = form.querySelector<HTMLInputElement>('[name="filled-in"]');
    const secondsField = form.querySelector<HTMLInputElement>('[name="seconds-on-form"]');

    // --- Trap 2 / captcha: nothing is fetched until the visitor engages, so the
    // page loads at exactly the same weight it does today. ---
    const slot = document.getElementById("recaptcha-slot");
    let captchaRequested = false;

    function loadCaptcha() {
      if (captchaRequested || !slot) return;
      captchaRequested = true;

      (window as any).onContactCaptchaReady = () => {
        (window as any).grecaptcha?.render(slot, {
          sitekey: slot.dataset.sitekey,
          theme: document.documentElement.classList.contains("dark") ? "dark" : "light",
        });
      };

      const script = document.createElement("script");
      script.src =
        "https://www.google.com/recaptcha/api.js?onload=onContactCaptchaReady&render=explicit";
      script.async = true;
      script.defer = true;
      document.head.appendChild(script);
    }

    function onFirstEngagement() {
      if (filledIn) filledIn.value = "human";
      loadCaptcha();
    }

    ["focusin", "pointerdown", "keydown"].forEach((eventName) =>
      form.addEventListener(eventName, onFirstEngagement, { once: true, passive: true }),
    );

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      errorBox.classList.add("hidden");

      if (!form.reportValidity()) return;

      const elapsed = (Date.now() - openedAt) / 1000;
      if (secondsField) secondsField.value = String(Math.round(elapsed));

      // No human types a name, an email and a message in under three seconds.
      if (elapsed < 3 || (filledIn && filledIn.value !== "human")) {
        showError(form.dataset.msgFast ?? "");
        return;
      }

      if (slot && !(window as any).grecaptcha?.getResponse?.()) {
        showError(form.dataset.msgCaptcha ?? "");
        loadCaptcha();
        return;
      }

      submit.disabled = true;
      submitText.textContent = form.dataset.msgSending ?? "…";

      try {
        // Netlify Forms collects submissions posted to any path on the site.
        const response = await fetch("/", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams(new FormData(form) as any).toString(),
        });

        if (!response.ok) throw new Error(`Request failed with ${response.status}`);

        form.classList.add("hidden");
        success.classList.remove("hidden");
        success.classList.add("flex");
        success.scrollIntoView({ behavior: "smooth", block: "center" });
      } catch {
        showError(form.dataset.msgError ?? "");
        // A rejected submission burns the captcha token, so clear it for the retry.
        (window as any).grecaptcha?.reset?.();
        submit.disabled = false;
        submitText.textContent = idleText;
      }
    });
  }
</script>
