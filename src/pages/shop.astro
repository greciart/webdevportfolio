---
import Layout from "../layouts/Layout.astro";
import Heading from "../components/ui/Heading.astro";
import Button from "../components/ui/Button.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { shopHubCopy } from "../i18n/shopHub";
import { getShopProducts } from "../i18n/shop";
import { getPaidTemplates, getFreebies } from "../i18n/kofi";
import { getLangFromUrl, localizePath } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const c = shopHubCopy[lang];
const p = (path: string) => localizePath(path, lang);

const models = getShopProducts(lang);
const templates = getPaidTemplates(lang);
const freebies = getFreebies(lang);

// One card per department. The cover is a real product from that section, so
// the hub shows what is inside instead of a generic illustration.
const retroSun = models.find((m) => m.id === "retro-sun")!;
const sections = [
  {
    ...c.sections.models,
    href: p("/shop/3d-models"),
    icon: "blender",
    count: models.length,
    cover: { src: retroSun.poster, alt: retroSun.alt },
  },
  {
    ...c.sections.templates,
    href: p("/shop/templates"),
    icon: "code",
    count: templates.length,
    cover: { image: templates[0].image, alt: templates[0].alt },
  },
  {
    ...c.sections.freebies,
    href: p("/shop/freebies"),
    icon: "document",
    count: freebies.length,
    cover: { image: freebies[0].image, alt: freebies[0].alt },
  },
];

const cardBorder =
  "relative rounded-2xl bg-linear-to-br from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 p-[2px] transition-all duration-500 hover:shadow-[0_10px_50px_rgba(13,188,130,0.2)]";
const eyebrow =
  "inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-600 dark:text-mint-300";
const bodyText =
  "text-base max-md:text-sm font-normal leading-7 text-blacktext/80 dark:text-gray-300";
const coverClass =
  "size-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105";
---

<Layout pageTitle={c.pageTitle} description={c.description}>
  <!-- ===================== HERO ===================== -->
  <section class="relative px-8 pb-8 pt-16 max-sm:px-4 max-sm:pt-10">
    <div class="blur-circle"></div>
    <div
      data-reveal="sharpen"
      class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center"
    >
      <span class={eyebrow}>
        <Icon name="cart" class="size-4" aria-hidden="true" />
        {c.heroEyebrow}
      </span>

      <Heading text={c.heroTitle} textGradient={c.heroTitleAccent} level={1} />

      <p class={`${bodyText} max-w-2xl`}>{c.heroIntro}</p>

      <p
        class="max-w-2xl rounded-2xl border border-mint-100 bg-white/70 px-6 py-4 text-sm font-normal leading-6 text-blacktext/70 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-400 max-sm:px-4"
      >
        {c.heroNote}
      </p>
    </div>
  </section>

  <!-- ===================== SECTIONS ===================== -->
  <section class="px-8 py-16 max-sm:px-4 max-sm:py-10">
    <ul
      data-reveal-stagger="up"
      class="mx-auto grid max-w-7xl grid-cols-3 gap-6 max-lg:grid-cols-1"
    >
      {
        sections.map((section) => (
          <li class={`${cardBorder} group`}>
            <a
              href={section.href}
              class="flex h-full flex-col gap-4 rounded-[calc(1rem-1px)] bg-white p-3 dark:bg-zinc-900/80"
            >
              <div class="relative aspect-video overflow-hidden rounded-xl bg-mint-50 dark:bg-zinc-800">
                {"image" in section.cover ? (
                  <Image
                    src={section.cover.image}
                    alt={section.cover.alt}
                    widths={[480, 800]}
                    sizes="(max-width: 1023px) 100vw, 400px"
                    loading="eager"
                    class={coverClass}
                  />
                ) : (
                  <img
                    src={section.cover.src}
                    alt={section.cover.alt}
                    width="800"
                    height="450"
                    loading="eager"
                    decoding="async"
                    class={coverClass}
                  />
                )}
                <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-mint-700 backdrop-blur-sm dark:bg-zinc-950/80 dark:text-mint-300">
                  {section.count} {section.countLabel}
                </span>
              </div>

              <div class="flex flex-1 flex-col gap-3 px-3 pb-3">
                <div class="flex items-center gap-3">
                  <Icon name={section.icon} class="size-6 text-mint-500 dark:text-mint-300" aria-hidden="true" />
                  <h2 class="text-xl font-bold text-blacktext dark:text-white">{section.title}</h2>
                </div>
                <span
                  class="h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500 transition-all duration-500 group-hover:w-20"
                  aria-hidden="true"
                />
                <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                  {section.description}
                </p>
                <span class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-semibold text-mint-600 transition-colors group-hover:text-riptide-500 dark:text-mint-300">
                  {section.cta}
                  <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="px-8 pb-20 max-sm:px-4 max-sm:pb-12">
    <div
      data-reveal="scale"
      class="mx-auto max-w-7xl rounded-2xl bg-linear-to-r from-mint-300 to-mint-50 p-[2px] dark:from-mint-600 dark:to-mint-200/5"
    >
      <div
        class="flex items-center justify-between gap-8 rounded-[calc(1rem-1px)] bg-linear-to-tr from-riptide-100 to-white px-10 py-12 dark:from-mint-950 dark:to-zinc-950 max-sm:flex-col max-sm:px-6 max-sm:py-8 max-sm:text-center"
      >
        <div class="flex max-w-3xl flex-col gap-3">
          <Heading text={c.ctaTitle} textGradient={c.ctaTitleAccent} level={2} />
          <p class="text-sm font-normal leading-6 text-blacktext/80 dark:text-gray-300">
            {c.ctaCopy}
          </p>
        </div>
        <div class="flex shrink-0 gap-4 max-sm:flex-col max-sm:items-center">
          <Button link={p("/contact")} text={c.ctaButton} iconName="envelope" variant="small" />
          <Button link={p("/packages")} text={c.ctaSecondary} iconName="briefcase" variant="smalldark" />
        </div>
      </div>
    </div>
  </section>
</Layout>
