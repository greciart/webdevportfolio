---
import Layout from "../../layouts/Layout.astro";
import Heading from "../../components/ui/Heading.astro";
import Button from "../../components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { shopCopy, getShopProducts } from "../../i18n/shop";
import { getLangFromUrl, localizePath } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const c = shopCopy[lang];
const products = getShopProducts(lang);
const p = (path: string) => localizePath(path, lang);

const { pageTitle, description } = c;

const filterKeys = ["all", "neon", "cute", "props"] as const;

const formatPrice = (price: number) =>
  `$${Number.isInteger(price) ? price : price.toFixed(2)}`;

// Each product is a schema.org Product with its Contra offer, so search can
// show the price next to the result. The offer URL is where the sale happens.
const schema = [
  {
    "@type": "ItemList",
    name: pageTitle,
    numberOfItems: products.length,
    itemListElement: products.map((product, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Product",
        name: product.name,
        description: product.blurb,
        image: new URL(product.poster, Astro.site).href,
        url: product.url,
        brand: { "@type": "Brand", name: "Grecia V." },
        offers: {
          "@type": "Offer",
          price: product.price.toFixed(2),
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: product.url,
        },
      },
    })),
  },
];

// Same tokens as packages and extras, so the shop reads as the same site.
const cardBorder =
  "relative rounded-2xl bg-linear-to-br from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 p-[2px] transition-all duration-500 hover:shadow-[0_10px_50px_rgba(13,188,130,0.2)]";
const cardInner =
  "h-full rounded-[calc(1rem-1px)] bg-white p-7 max-sm:p-5 dark:bg-zinc-900/80";
// Product cards keep the same shell but a tighter padding, so the preview
// can run almost edge to edge.
const productInner =
  "flex h-full flex-col gap-4 rounded-[calc(1rem-1px)] bg-white p-3 dark:bg-zinc-900/80";
const eyebrow =
  "inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-600 dark:text-mint-300";
const bodyText =
  "text-base max-md:text-sm font-normal leading-7 text-blacktext/80 dark:text-gray-300";
const sectionWrap = "scroll-m-24 px-8 py-16 max-sm:px-4 max-sm:py-10";
---

<Layout pageTitle={pageTitle} description={description} schema={schema}>
  <!-- ===================== HERO ===================== -->
  <section class="relative px-8 pb-8 pt-16 max-sm:px-4 max-sm:pt-10">
    <div class="blur-circle"></div>
    <div
      data-reveal="sharpen"
      class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center"
    >
      <a
        href={p("/shop")}
        class="text-xs font-semibold text-blacktext/50 transition-colors hover:text-mint-600 dark:text-zinc-500 dark:hover:text-mint-300"
      >
        ← {c.backToShop}
      </a>

      <span class={eyebrow}>
        <Icon name="blender" class="size-4" aria-hidden="true" />
        {c.heroEyebrow}
      </span>

      <Heading text={c.heroTitle} textGradient={c.heroTitleAccent} level={1} />

      <p class={`${bodyText} max-w-2xl`}>{c.heroIntro}</p>

      <dl class="mt-2 grid w-full max-w-2xl grid-cols-3 gap-4 max-sm:grid-cols-1 max-sm:gap-3">
        {
          c.stats.map((stat) => (
            <div class="flex flex-col items-center gap-1 rounded-2xl border border-mint-100 bg-white/70 px-4 py-4 dark:border-zinc-800 dark:bg-zinc-900/50">
              <dt class="sr-only">{stat.label}</dt>
              <dd class="text-xl font-extrabold text-blacktext dark:text-white">{stat.value}</dd>
              <dd class="text-[11px] font-semibold uppercase tracking-widest text-blacktext/50 dark:text-zinc-500">
                {stat.label}
              </dd>
            </div>
          ))
        }
      </dl>

      <p
        class="max-w-2xl rounded-2xl border border-mint-100 bg-white/70 px-6 py-4 text-sm font-normal leading-6 text-blacktext/70 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-400 max-sm:px-4"
      >
        {c.heroNote}
      </p>
    </div>
  </section>

  <!-- ===================== PRODUCTS ===================== -->
  <section id="models" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header
        data-reveal="blur"
        class="flex items-end justify-between gap-6 max-lg:flex-col max-lg:items-start"
      >
        <Heading text={c.gridTitle} textGradient={c.gridTitleAccent} level={2} />

        <div
          class="flex flex-wrap gap-2"
          role="group"
          aria-label={c.filtersLabel}
          data-shop-filters
        >
          {
            filterKeys.map((key) => (
              <button
                type="button"
                data-filter={key}
                aria-pressed={key === "all" ? "true" : "false"}
                class="cursor-pointer rounded-full border border-mint-200 bg-white px-4 py-2 text-sm font-semibold text-blacktext transition-all hover:-translate-y-0.5 hover:border-mint-400 hover:text-mint-600 aria-pressed:border-transparent aria-pressed:bg-linear-to-r aria-pressed:from-riptide-300 aria-pressed:to-mint-300 aria-pressed:text-blacktext dark:border-zinc-800 dark:bg-zinc-900 dark:text-white dark:hover:border-mint-500 dark:hover:text-mint-300 dark:aria-pressed:from-riptide-500 dark:aria-pressed:to-mint-500 dark:aria-pressed:text-white max-sm:text-xs"
              >
                {c.filters[key]}
              </button>
            ))
          }
        </div>
      </header>

      <ul
        data-reveal-stagger="up"
        class="grid grid-cols-3 gap-6 max-xl:grid-cols-2 max-md:grid-cols-1"
      >
        {
          products.map((product, i) => (
            <li class={`${cardBorder} group`} data-category={product.category}>
              <article class={productInner}>
                <div
                  class="relative aspect-video overflow-hidden rounded-xl bg-mint-50 dark:bg-zinc-800"
                  data-shop-media
                >
                  <img
                    src={product.poster}
                    alt={product.alt}
                    width="800"
                    height="450"
                    loading={i < 3 ? "eager" : "lazy"}
                    decoding="async"
                    class="size-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  />
                  {product.preview && (
                    <video
                      data-src={product.preview}
                      muted
                      loop
                      playsinline
                      preload="none"
                      aria-hidden="true"
                      tabindex="-1"
                      class="pointer-events-none absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-500"
                    />
                  )}

                  <div class="absolute left-3 top-3 flex gap-2">
                    {product.animated && (
                      <span class="flex items-center gap-1.5 rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-mint-700 backdrop-blur-sm dark:bg-zinc-950/80 dark:text-mint-300">
                        <span class="size-1.5 animate-pulse rounded-full bg-mint-500" aria-hidden="true" />
                        {c.animatedBadge}
                      </span>
                    )}
                    {product.bundle && (
                      <span class="rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-blacktext backdrop-blur-sm dark:bg-zinc-950/80 dark:text-white">
                        {c.bundleBadge}
                      </span>
                    )}
                  </div>
                </div>

                <div class="flex flex-1 flex-col gap-3 px-3 pb-3">
                  <span class="text-[10px] font-bold uppercase tracking-widest text-blacktext/40 dark:text-zinc-500">
                    {c.categoryLabel[product.category]}
                  </span>
                  <h3 class="text-lg font-bold text-blacktext dark:text-white">{product.name}</h3>
                  <span
                    class="h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500 transition-all duration-500 group-hover:w-20"
                    aria-hidden="true"
                  />
                  <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                    {product.blurb}
                  </p>

                  <div class="mt-auto flex items-center justify-between gap-4 pt-2">
                    <span class="text-2xl font-extrabold text-blacktext dark:text-white">
                      {formatPrice(product.price)}
                      <span class="ml-1 text-xs font-semibold text-blacktext/40 dark:text-zinc-500">USD</span>
                    </span>
                    <Button
                      link={product.url}
                      text={c.buyButton}
                      ariaLabel={c.buyAria.replace("{name}", product.name)}
                      iconName="cart"
                      variant="small"
                    />
                  </div>
                </div>
              </article>
            </li>
          ))
        }
      </ul>

      <p
        data-reveal="fade"
        class="text-sm font-normal leading-6 text-blacktext/60 dark:text-zinc-400"
      >
        {c.checkoutNote}
      </p>
    </div>
  </section>

  <!-- ===================== WHY ===================== -->
  <section id="why" class={sectionWrap}>
    <div class="mx-auto flex max-w-7xl flex-col gap-10">
      <header data-reveal="blur-up" class="flex flex-col gap-4">
        <Heading text={c.whyTitle} textGradient={c.whyTitleAccent} level={2} />
        <p class={`${bodyText} max-w-3xl`}>{c.whyIntro}</p>
      </header>

      <div
        data-reveal-stagger="scale"
        class="grid grid-cols-3 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1"
      >
        {
          c.why.map((item) => (
            <article class={cardBorder}>
              <div class={`${cardInner} flex flex-col gap-3`}>
                <span class="flex size-11 items-center justify-center rounded-xl border border-mint-200 bg-mint-50 text-mint-600 dark:border-mint-800/50 dark:bg-mint-900/30 dark:text-mint-300">
                  <Icon class="size-5" name={item.icon} aria-hidden="true" />
                </span>
                <h3 class="text-lg font-bold text-blacktext dark:text-white">{item.name}</h3>
                <span
                  class="h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500"
                  aria-hidden="true"
                />
                <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                  {item.description}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section id="faq" class={sectionWrap}>
    <div class="mx-auto flex max-w-4xl flex-col gap-10">
      <header data-reveal="blur" class="flex flex-col gap-4">
        <Heading text={c.faqTitle} textGradient={c.faqTitleAccent} level={2} />
      </header>

      <div data-reveal-stagger="up" class="flex flex-col gap-4">
        {
          c.faq.map((item) => (
            <details class="group/faq rounded-2xl border border-mint-100 bg-white/70 transition-colors open:border-mint-300 hover:border-mint-300 dark:border-zinc-800 dark:bg-zinc-900/50 dark:open:border-mint-700 dark:hover:border-mint-700">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base font-bold text-blacktext dark:text-white max-sm:px-5 [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg
                  class="size-4 shrink-0 text-mint-500 transition-transform duration-300 group-open/faq:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="px-6 pb-5 text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400 max-sm:px-5">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== CTA ===================== -->
  <section class="px-8 pb-20 max-sm:px-4 max-sm:pb-12">
    <div
      data-reveal="scale"
      class="mx-auto max-w-7xl rounded-2xl bg-linear-to-r from-mint-300 to-mint-50 p-[2px] dark:from-mint-600 dark:to-mint-200/5"
    >
      <div
        class="flex items-center justify-between gap-8 rounded-[calc(1rem-1px)] bg-linear-to-tr from-riptide-100 to-white px-10 py-12 dark:from-mint-950 dark:to-zinc-950 max-sm:flex-col max-sm:px-6 max-sm:py-8 max-sm:text-center"
      >
        <div class="flex max-w-3xl flex-col gap-3">
          <Heading text={c.ctaTitle} textGradient={c.ctaTitleAccent} level={2} />
          <p class="text-sm font-normal leading-6 text-blacktext/80 dark:text-gray-300">
            {c.ctaCopy}
          </p>
        </div>
        <div class="flex shrink-0 gap-4 max-sm:flex-col max-sm:items-center">
          <Button link={p("/contact")} text={c.ctaButton} iconName="envelope" variant="small" />
          <Button
            link={`${p("/extras")}#3d-modeling`}
            text={c.ctaSecondary}
            iconName="blender"
            variant="smalldark"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // --- Filters ---------------------------------------------------------------
  // Plain show/hide on the list items. Every product stays in the HTML, so
  // search engines and no-JS visitors always see the full catalogue.
  const filterGroup = document.querySelector<HTMLElement>("[data-shop-filters]");
  const cards = document.querySelectorAll<HTMLElement>("[data-category]");

  filterGroup?.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
    if (!button) return;
    const filter = button.dataset.filter;

    filterGroup
      .querySelectorAll<HTMLButtonElement>("[data-filter]")
      .forEach((b) => b.setAttribute("aria-pressed", String(b === button)));

    cards.forEach((card) => {
      card.hidden = filter !== "all" && card.dataset.category !== filter;
    });
  });

  // --- Animated previews -----------------------------------------------------
  // The grid shows stills. The video for an animated model is only fetched the
  // first time someone hovers it (or, on touch screens, scrolls it into the
  // middle of the view), so the page does not pull five MP4s on load.
  const root = document.documentElement;
  const motionOff = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches ||
    root.dataset.a11yMotion === "off";

  const play = (video: HTMLVideoElement) => {
    if (motionOff()) return;
    if (!video.src && video.dataset.src) video.src = video.dataset.src;
    video.play().then(
      () => video.classList.replace("opacity-0", "opacity-100"),
      () => {},
    );
  };
  const stop = (video: HTMLVideoElement) => {
    video.pause();
    video.classList.replace("opacity-100", "opacity-0");
  };

  const media = document.querySelectorAll<HTMLElement>("[data-shop-media]");
  const canHover = window.matchMedia("(hover: hover)").matches;

  if (canHover) {
    media.forEach((box) => {
      const video = box.querySelector("video");
      const card = box.closest("li");
      if (!video || !card) return;
      card.addEventListener("mouseenter", () => play(video));
      card.addEventListener("mouseleave", () => stop(video));
      card.addEventListener("focusin", () => play(video));
      card.addEventListener("focusout", () => stop(video));
    });
  } else if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target.querySelector("video");
          if (!video) continue;
          if (entry.isIntersecting) play(video);
          else stop(video);
        }
      },
      { rootMargin: "-30% 0px -30% 0px" },
    );
    media.forEach((box) => box.querySelector("video") && observer.observe(box));
  }
</script>
