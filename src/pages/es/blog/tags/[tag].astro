---
import Layout from '../../../../layouts/Layout.astro';
import BlogPost from '../../../../components/blog/BlogPost.astro';
import Heading from '../../../../components/ui/Heading.astro';
import { toSlug } from '../../../../i18n/utils';

export async function getStaticPaths() {
    const modules = import.meta.glob("../../../es/blog/posts/*.md", { eager: true });

    const allPosts: any[] = Object.entries(modules).map(([path, mod]: any) => ({
        ...mod,
        url: path.replace(/^.*\/posts/, '/es/blog/posts').replace('.md', '/'),
    }));

    const uniqueTags: string[] = [
        ...new Set(allPosts.map((post: any) => post.frontmatter.tags).flat()),
    ];

    return uniqueTags.map((tag) => {
        const filteredPosts = allPosts.filter((post) =>
            post.frontmatter.tags.includes(tag),
        );
        return {
            params: { tag: toSlug(tag) },
            props: { posts: filteredPosts, label: tag },
        };
    });
}

const { posts, label } = Astro.props;
---

<Layout pageTitle={`Artículos sobre ${label} | Grecia V.`} description={`Todos los artículos etiquetados como ${label} en el blog de Grecia V., diseñadora web y desarrolladora frontend.`}>
    <section class="py-8">
        <div class="flex flex-col gap-8 max-w-4xl mx-auto">
            <Heading text="Artículos sobre" textGradient={label}/>
            {
                posts.map((post) => (
                    <BlogPost url={post.url} title={post.frontmatter.title} date={post.frontmatter.pubDate } tags={post.frontmatter.tags }  languages={post.frontmatter.languages } image={post.frontmatter.image } />
                ))
            }
        </div>
    </section>

</Layout>
