---
/**
 * Shell for the legal pages (privacy, cookies). The text lives in Markdown so
 * it can be edited like a blog post; this only frames it in the same card the
 * About page uses and adds the contact block every policy has to end with.
 */
import Layout from "./Layout.astro";
import Heading from "../components/ui/Heading.astro";
import { getCollection } from "astro:content";
import { getLangFromUrl, localizePath, useTranslations } from "../i18n/utils";

const { frontmatter } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = (path: string) => localizePath(path, lang);

const [staticData] = await getCollection("staticData");
const { email } = staticData.data;

const updated = new Date(frontmatter.updated).toLocaleDateString(
  lang === "es" ? "es-ES" : "en-US",
  { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" },
);

const copy = {
  en: {
    updated: "Last updated",
    questions: "Questions about your data?",
    questionsCopy:
      "Write to me and I will answer within 30 days. You can also ask me to see, correct or delete anything I hold about you.",
    contactPage: "Or use the contact form",
  },
  es: {
    updated: "Última actualización",
    questions: "¿Dudas sobre tus datos?",
    questionsCopy:
      "Escríbeme y te respondo en un máximo de 30 días. También puedes pedirme ver, corregir o borrar cualquier dato que tenga sobre ti.",
    contactPage: "O usa el formulario de contacto",
  },
}[lang];

// The two policies point at each other, so whichever one a visitor lands on,
// the other is one click away.
const other =
  frontmatter.kind === "privacy"
    ? { href: p("/cookies"), label: t("footer.cookies") }
    : { href: p("/privacy"), label: t("footer.privacy") };

const eyebrow =
  "inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-600 dark:text-mint-300";
---

<Layout pageTitle={frontmatter.title} description={frontmatter.description}>
  <!-- data-selectable: legal text is exactly what people need to be able to
       copy, so it is exempt from the site-wide copy protection. -->
  <section data-selectable class="relative px-8 pb-20 pt-16 max-sm:px-4 max-sm:pt-10">
    <div class="blur-circle" aria-hidden="true"></div>

    <header data-reveal="sharpen" class="mx-auto flex max-w-3xl flex-col items-center gap-4 text-center">
      <span class={eyebrow}>
        <span class="h-px w-8 bg-mint-400"></span>
        {t("footer.legal")}
        <span class="h-px w-8 bg-mint-400"></span>
      </span>
      <Heading text={frontmatter.heading} textGradient={frontmatter.headingAccent} level={1} />
      <p class="text-xs font-medium text-blacktext/60 dark:text-zinc-400">
        {copy.updated}: <time datetime={frontmatter.updated}>{updated}</time>
      </p>
    </header>

    <article
      data-reveal="blur-up"
      class="markdown legal mx-auto mt-10 max-w-3xl rounded-2xl border border-neutral-100 bg-white px-14 py-10 max-md:px-8 max-sm:px-5 max-sm:py-8 dark:border-0 dark:bg-transparent"
    >
      <slot />
    </article>

    <div
      data-reveal="up"
      class="mx-auto mt-8 max-w-3xl rounded-2xl bg-linear-to-br from-mint-300 to-mint-50 p-[2px] dark:from-mint-600 dark:to-mint-200/5"
    >
      <div
        class="flex flex-col gap-3 rounded-[calc(1rem-1px)] bg-linear-to-tr from-riptide-100 to-white p-7 max-sm:p-5 dark:from-mint-950 dark:to-zinc-950"
      >
        <h2 class="text-lg font-bold text-blacktext dark:text-white">{copy.questions}</h2>
        <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-300">
          {copy.questionsCopy}
        </p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
          <a
            href={`mailto:${email}`}
            class="font-semibold text-mint-600 underline underline-offset-4 transition-colors hover:text-riptide-500 dark:text-mint-300"
          >
            {email}
          </a>
          <a
            href={p("/contact")}
            class="font-medium text-blacktext/60 transition-colors hover:text-mint-600 dark:text-zinc-400 dark:hover:text-mint-300"
          >
            {copy.contactPage} →
          </a>
        </div>
      </div>
    </div>

    <p class="mx-auto mt-6 max-w-3xl text-center text-xs font-medium text-blacktext/60 dark:text-zinc-400">
      <a href={other.href} class="transition-colors hover:text-mint-600 dark:hover:text-mint-300">
        {other.label} →
      </a>
    </p>
  </section>
</Layout>

<style is:global>
  /* The blog's heading rhythm (4rem above every h2) is built for long reads
     with images between sections. A policy is a stack of short sections, and at
     that spacing it reads as mostly empty space. */
  .markdown.legal h2 {
    font-size: 1.375rem;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
  }
  .markdown.legal > :first-child {
    margin-top: 0;
  }
  .markdown.legal p {
    margin-bottom: 1.25rem;
  }
  .markdown.legal ul {
    margin-top: 0.5rem;
    margin-bottom: 1.5rem;
  }
</style>
