---
import Layout from "./Layout.astro";
import Capsule from "../components/ui/Capsule.astro";
import Heading from "../components/ui/Heading.astro";
import NavArticle from "../components/layout/NavArticle.astro";
import Contact from "../components/portfolio/Contact.astro";
import ProjectGallery from "../components/layout/ProjectGallery.astro";
import { Image } from 'astro:assets';  // 👈 agrega esto
import type { ImageMetadata } from 'astro';

const { frontmatter } = Astro.props;
const gallery = frontmatter.gallery ?? [];

const projectUrl = new URL(Astro.url.pathname, Astro.site).href;
// A case study is a piece of work, not an article. `CreativeWork` with an
// explicit creator is what makes the portfolio read as a body of work by one
// person rather than fifteen unrelated pages.
const projectSchema = [
  {
    "@type": "CreativeWork",
    "@id": `${projectUrl}#project`,
    name: frontmatter.title,
    description: frontmatter.description,
    datePublished: new Date(frontmatter.pubDate).toISOString().slice(0, 10),
    creator: { "@id": `${Astro.site}#person` },
    mainEntityOfPage: { "@id": projectUrl },
    ...(frontmatter.image?.url
      ? { image: new URL(frontmatter.image.url.src ?? frontmatter.image.url, Astro.site).href }
      : {}),
    ...(frontmatter.languages?.length ? { keywords: frontmatter.languages.join(", ") } : {}),
  },
];
---

<Layout
  pageTitle={frontmatter.title}
  description={frontmatter.description}
  ogimage={frontmatter.image}
  schema={projectSchema}
>
  <section class="relative mx-auto px-8 max-sm:px-4 flex flex-row justify-center gap-6">
    
    <ProjectGallery images={gallery} />

    <article data-reveal="sharpen" class="flex flex-col gap-8 max-w-3xl max-md:w-full pb-10 pt-8 mt-8 px-14 max-md:px-10 max-sm:px-4 dark:bg-transparent bg-white dark:border-0 border border-neutral-100 rounded-2xl">
      <header class="flex flex-col gap-4" id="start">
        <div class="flex gap-2 flex-wrap">
          {frontmatter.languages.map((language: string) => (
            <Capsule linkEnabled={false} lang={language} />
          ))}
        </div>
        <div class="mt-3">
          <Heading text={frontmatter.title} />
        </div>
      </header>

      <!-- Mobile gallery arriba -->
      {gallery.length > 0 && (
        <div class="xl:hidden flex flex-col gap-4">
          <!-- h2, not h3: the case study body starts at h2, so an h3 here left
               the outline jumping straight from the title to a third level. -->
          <h2 class="dark:text-zinc-400 text-blacktext/90 font-black tracking-wide text-sm uppercase">Project Gallery</h2>
{gallery.map((img: {url: ImageMetadata, alt: string}) => (
  <a href={(img.url as any).src} target="_blank">
    <Image src={img.url} alt={img.alt} class="w-full rounded-xl" />
  </a>
))}
        </div>
      )}

{!frontmatter.hideCover && frontmatter.image?.url && (
  <figure>
    <Image class="w-full rounded-xl" src={frontmatter.image.url} alt={frontmatter.image.alt || "Article image"} />
  </figure>
)}

      <div class="markdown" id="content">
        <slot />
      </div>
    </article>

    <NavArticle title={frontmatter.title} />
  </section>
  <Contact />
</Layout>