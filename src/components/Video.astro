---
/**
 * Lazy video embed. Renders a poster with a play button and only builds the
 * iframe or <video> on interaction, so an unplayed embed costs nothing beyond
 * the poster image.
 *
 * Props:
 *  - provider: 'youtube' | 'vimeo' | 'file' (default: 'youtube')
 *  - id: video id, for youtube/vimeo
 *  - src: url of a local file (mp4), for provider 'file'
 *  - poster: poster image url
 *  - captions: optional VTT url
 *  - aspect: padding-top percentage, e.g. '56.25%'
 *  - class: extra classes on the wrapper
 */
interface Props {
  provider?: "youtube" | "vimeo" | "file";
  id?: string;
  src?: string;
  poster?: string;
  captions?: string;
  aspect?: string;
  alt?: string;
  class?: string;
  "aria-label"?: string;
}

const {
  provider = "youtube",
  id = "",
  src = "",
  poster = "",
  captions = "",
  aspect = "56.25%",
  alt = "Video preview",
  class: className = "",
  "aria-label": ariaLabel = "Reproducir video",
} = Astro.props;

const fallbackPoster =
  poster || (provider === "youtube" && id ? `https://i.ytimg.com/vi/${id}/hqdefault.jpg` : "");
---

<div class:list={["astro-video-wrapper", className]}>
  <div class="astro-video-inner" style={`padding-top:${aspect};`}>
    <div
      class="astro-video-placeholder"
      role="button"
      tabindex="0"
      aria-label={ariaLabel}
      data-provider={provider}
      data-id={id}
      data-src={src}
      data-poster={poster}
      data-captions={captions}
    >
      {fallbackPoster ? (
        <img src={fallbackPoster} alt={alt} />
      ) : (
        <div style="background:#000;width:100%;height:100%;"></div>
      )}
      <button class="astro-video-play" aria-hidden="true" tabindex="-1">▶</button>
    </div>
  </div>
</div>

<style>
  .astro-video-wrapper { max-width:100%; }
  .astro-video-inner { position:relative; width:100%; }
  .astro-video-placeholder { position:absolute; left:0; top:0; width:100%; height:100%; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .astro-video-placeholder img { position:absolute; left:0; top:0; width:100%; height:100%; object-fit:cover; }
  .astro-video-play { position:relative; z-index:2; background:rgba(0,0,0,0.6); color:#fff; border:0; border-radius:999px; padding:0.5rem 0.7rem; font-size:1.25rem; }
</style>

<script>
  // Swaps the poster for the real player on click. Delegated from the document,
  // so one listener covers every embed on the page no matter how many render.
  function setFill(el: HTMLElement) {
    el.style.position = "absolute";
    el.style.left = "0";
    el.style.top = "0";
    el.style.width = "100%";
    el.style.height = "100%";
  }

  function mountVideo(el: HTMLElement | null) {
    if (!el) return;
    const { provider, id, src, captions } = el.dataset;

    if ((provider === "youtube" || provider === "vimeo") && id) {
      const iframe = document.createElement("iframe");
      iframe.src =
        provider === "youtube"
          ? `https://www.youtube.com/embed/${id}?autoplay=1&rel=0`
          : `https://player.vimeo.com/video/${id}?autoplay=1&title=0&byline=0&portrait=0&badge=0&dnt=1`;
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen";
      iframe.allowFullscreen = true;
      iframe.setAttribute("frameborder", "0");
      setFill(iframe);
      el.replaceChildren(iframe);
      return;
    }

    if (provider === "file" && src) {
      const video = document.createElement("video");
      video.controls = true;
      video.playsInline = true;
      video.autoplay = true;
      video.preload = "metadata";
      setFill(video);

      const source = document.createElement("source");
      source.src = src;
      if (src.endsWith(".mp4")) source.type = "video/mp4";
      video.appendChild(source);

      if (captions) {
        const track = document.createElement("track");
        track.kind = "captions";
        track.src = captions;
        track.srclang = "es";
        track.label = "Español";
        video.appendChild(track);
      }

      el.replaceChildren(video);
      video.play().catch(() => {});
    }
  }

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    mountVideo(target?.closest<HTMLElement>(".astro-video-placeholder") ?? null);
  });

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" && e.key !== " ") return;
    const active = document.activeElement as HTMLElement | null;
    if (active?.classList.contains("astro-video-placeholder")) {
      e.preventDefault();
      mountVideo(active);
    }
  });
</script>
