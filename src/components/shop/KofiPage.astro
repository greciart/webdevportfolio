---
// The Templates and Freebies pages are the same layout with different items
// and copy, so both render through here.
import Layout from "../../layouts/Layout.astro";
import Heading from "../ui/Heading.astro";
import Button from "../ui/Button.astro";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import { kofiLabels, type KofiItem } from "../../i18n/kofi";
import { getLangFromUrl, localizePath } from "../../i18n/utils";

interface Props {
  items: KofiItem[];
  copy: {
    pageTitle: string;
    description: string;
    heroEyebrow: string;
    heroTitle: string;
    heroTitleAccent: string;
    heroIntro: string;
    heroNote: string;
    faqTitle: string;
    faqTitleAccent: string;
    faq: { question: string; answer: string }[];
  };
  icon: string;
}

const { items, copy: c, icon } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const l = kofiLabels[lang];
const p = (path: string) => localizePath(path, lang);

// The button names the store the visitor is about to land on.
const buttonText = (item: KofiItem) =>
  item.store === "renderhub" ? l.downloadRenderhub : item.price === 0 ? l.download : l.buy;
const buttonAria = (item: KofiItem) =>
  item.store === "renderhub"
    ? l.downloadRenderhubAria
    : item.price === 0
      ? l.downloadAria
      : l.buyAria;

const formatPrice = (price: number) =>
  price === 0 ? l.free : `$${Number.isInteger(price) ? price : price.toFixed(2)}`;

const schema = [
  {
    "@type": "ItemList",
    name: c.pageTitle,
    numberOfItems: items.length,
    itemListElement: items.map((item, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Product",
        name: item.name,
        description: item.blurb,
        image: new URL(item.image.src, Astro.site).href,
        url: item.url,
        brand: { "@type": "Brand", name: "Grecia V." },
        offers: {
          "@type": "Offer",
          price: item.price.toFixed(2),
          priceCurrency: "USD",
          availability: "https://schema.org/InStock",
          url: item.url,
        },
      },
    })),
  },
];

const cardBorder =
  "relative rounded-2xl bg-linear-to-br from-mint-300 dark:from-mint-600 to-mint-50 dark:to-mint-200/5 p-[2px] transition-all duration-500 hover:shadow-[0_10px_50px_rgba(13,188,130,0.2)]";
const productInner =
  "flex h-full flex-col gap-4 rounded-[calc(1rem-1px)] bg-white p-3 dark:bg-zinc-900/80";
const eyebrow =
  "inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-widest text-mint-600 dark:text-mint-300";
const bodyText =
  "text-base max-md:text-sm font-normal leading-7 text-blacktext/80 dark:text-gray-300";
const sectionWrap = "scroll-m-24 px-8 py-16 max-sm:px-4 max-sm:py-10";
---

<Layout pageTitle={c.pageTitle} description={c.description} schema={schema}>
  <!-- ===================== HERO ===================== -->
  <section class="relative px-8 pb-8 pt-16 max-sm:px-4 max-sm:pt-10">
    <div class="blur-circle"></div>
    <div
      data-reveal="sharpen"
      class="mx-auto flex max-w-4xl flex-col items-center gap-6 text-center"
    >
      <a
        href={p("/shop")}
        class="text-xs font-semibold text-blacktext/50 transition-colors hover:text-mint-600 dark:text-zinc-500 dark:hover:text-mint-300"
      >
        ← {l.backToShop}
      </a>

      <span class={eyebrow}>
        <Icon name={icon} class="size-4" aria-hidden="true" />
        {c.heroEyebrow}
      </span>

      <Heading text={c.heroTitle} textGradient={c.heroTitleAccent} level={1} />

      <p class={`${bodyText} max-w-2xl`}>{c.heroIntro}</p>

      <p
        class="max-w-2xl rounded-2xl border border-mint-100 bg-white/70 px-6 py-4 text-sm font-normal leading-6 text-blacktext/70 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-400 max-sm:px-4"
      >
        {c.heroNote}
      </p>
    </div>
  </section>

  <!-- ===================== ITEMS ===================== -->
  <section class={sectionWrap}>
    <ul
      data-reveal-stagger="up"
      class="mx-auto grid max-w-7xl grid-cols-3 gap-6 max-xl:grid-cols-2 max-md:grid-cols-1"
    >
      {
        items.map((item, i) => (
          <li class={`${cardBorder} group`}>
            <article class={productInner}>
              <div class="relative aspect-video overflow-hidden rounded-xl bg-mint-50 dark:bg-zinc-800">
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[480, 800]}
                  sizes="(max-width: 767px) 100vw, (max-width: 1279px) 50vw, 400px"
                  loading={i < 3 ? "eager" : "lazy"}
                  class="size-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                />
                <div class="absolute left-3 top-3 flex gap-2">
                  {item.price === 0 && (
                    <span class="rounded-full bg-linear-to-r from-riptide-300 to-mint-300 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-blacktext">
                      {l.free}
                    </span>
                  )}
                  <span class="rounded-full bg-white/90 px-2.5 py-1 text-[10px] font-bold uppercase tracking-widest text-blacktext backdrop-blur-sm dark:bg-zinc-950/80 dark:text-white">
                    {l.kind[item.kind]}
                  </span>
                </div>
              </div>

              <div class="flex flex-1 flex-col gap-3 px-3 pb-3">
                <h2 class="text-lg font-bold text-blacktext dark:text-white">{item.name}</h2>
                <span
                  class="h-0.5 w-10 rounded-full bg-linear-to-r from-riptide-400 to-mint-500 transition-all duration-500 group-hover:w-20"
                  aria-hidden="true"
                />
                <p class="text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400">
                  {item.blurb}
                </p>

                <ul class="flex flex-col gap-1.5">
                  {item.features.map((feature) => (
                    <li class="flex items-start gap-2.5 text-sm font-normal leading-6 text-blacktext/80 dark:text-zinc-300">
                      <span class="mt-2 size-1.5 shrink-0 rotate-45 bg-riptide-400" aria-hidden="true" />
                      {feature}
                    </li>
                  ))}
                </ul>

                <p class="text-xs font-normal leading-5 text-blacktext/60 dark:text-zinc-400">
                  <span class="font-bold uppercase tracking-widest text-[10px] text-blacktext/40 dark:text-zinc-500">
                    {l.bestFor}:
                  </span>{" "}
                  {item.bestFor}
                </p>

                {item.siblingItem && (
                  <a
                    href={item.siblingItem.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-semibold text-mint-600 underline underline-offset-4 transition-colors hover:text-riptide-500 dark:text-mint-300"
                  >
                    {item.siblingItem.free ? l.siblingFree : l.siblingPaid} ↗
                  </a>
                )}

                <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-2">
                  <span class="text-2xl font-extrabold text-blacktext dark:text-white">
                    {formatPrice(item.price)}
                    {item.price > 0 && (
                      <span class="ml-1 text-xs font-semibold text-blacktext/40 dark:text-zinc-500">USD</span>
                    )}
                  </span>
                  <div class="flex flex-wrap items-center gap-3">
                    {item.demo && (
                      <a
                        href={item.demo}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm font-semibold text-mint-600 transition-colors hover:text-riptide-500 dark:text-mint-300"
                      >
                        {l.demo} ↗
                      </a>
                    )}
                    <Button
                      link={item.url}
                      text={buttonText(item)}
                      ariaLabel={buttonAria(item).replace("{name}", item.name)}
                      iconName={item.price === 0 ? "document" : "cart"}
                      variant="small"
                    />
                  </div>
                </div>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- ===================== FAQ ===================== -->
  <section class={sectionWrap}>
    <div class="mx-auto flex max-w-4xl flex-col gap-10">
      <header data-reveal="blur" class="flex flex-col gap-4">
        <Heading text={c.faqTitle} textGradient={c.faqTitleAccent} level={2} />
      </header>

      <div data-reveal-stagger="up" class="flex flex-col gap-4">
        {
          c.faq.map((item) => (
            <details class="group/faq rounded-2xl border border-mint-100 bg-white/70 transition-colors open:border-mint-300 hover:border-mint-300 dark:border-zinc-800 dark:bg-zinc-900/50 dark:open:border-mint-700 dark:hover:border-mint-700">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 text-base font-bold text-blacktext dark:text-white max-sm:px-5 [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg
                  class="size-4 shrink-0 text-mint-500 transition-transform duration-300 group-open/faq:rotate-45"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="round"
                  aria-hidden="true"
                >
                  <path d="M12 5v14M5 12h14" />
                </svg>
              </summary>
              <p class="px-6 pb-5 text-sm font-normal leading-6 text-blacktext/70 dark:text-zinc-400 max-sm:px-5">
                {item.answer}
              </p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
