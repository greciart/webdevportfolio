---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Multipliers applied to the base size in global.css.
const textSizes = [
  { value: "1", label: t("a11y.textNormal"), sample: "A" },
  { value: "1.15", label: t("a11y.textLarge"), sample: "A" },
  { value: "1.3", label: t("a11y.textLarger"), sample: "A" },
];

// Every switch is a boolean that maps to one data attribute on <html>, so the
// whole feature stays in CSS and the script only writes attributes.
const toggles = [
  { key: "contrast", label: t("a11y.contrast") },
  { key: "spacing", label: t("a11y.spacing") },
  { key: "readableFont", label: t("a11y.readableFont") },
  { key: "underline", label: t("a11y.underline") },
  { key: "focus", label: t("a11y.focus") },
  { key: "motion", label: t("a11y.motion") },
];
---

<!-- Mirrors the language switcher: hover or keyboard focus opens it, and the
     preferences live on <html> so CSS alone applies them. -->
<div class="a11y-menu relative flex items-center group" data-a11y-menu>
  <button
    type="button"
    class="flex cursor-pointer items-center gap-1.5 rounded-full border border-mint-200 bg-white/70 px-3 py-1.5 max-md:px-2 text-xs font-bold tracking-wide text-blacktext transition-all hover:border-mint-400 hover:text-mint-600 dark:border-zinc-700 dark:bg-zinc-900/70 dark:text-zinc-200 dark:hover:border-mint-400 dark:hover:text-mint-300"
    aria-label={t("a11y.open")}
    aria-haspopup="true"
  >
    <svg
      class="size-3.5 opacity-70"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="10" />
      <circle cx="12" cy="7.5" r="1.2" fill="currentColor" stroke="none" />
      <path d="M7.5 10.5h9" />
      <path d="M12 10.5v4m0 0-2.2 4m2.2-4 2.2 4" />
    </svg>
    <svg
      class="size-3 opacity-60 transition-transform duration-200 max-md:hidden md:group-hover:rotate-180"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="3"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </button>

  <div
    class="absolute right-0 top-full z-50 pt-3 opacity-0 invisible translate-y-1 transition-all duration-200 ease-out group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0"
  >
    <div
      class="min-w-[230px] rounded-2xl border border-mint-100 bg-white/95 p-3 shadow-xl shadow-mint-500/10 backdrop-blur-md dark:border-zinc-800 dark:bg-zinc-900/95"
    >
      <p class="px-1 pb-2 text-[10px] font-bold uppercase tracking-wider text-blacktext/50 dark:text-zinc-500">
        {t("a11y.title")}
      </p>

      <p class="px-1 pb-1.5 text-xs font-medium text-blacktext dark:text-zinc-300">
        {t("a11y.textSize")}
      </p>
      <div class="flex gap-1.5 pb-3" role="group" aria-label={t("a11y.textSize")}>
        {
          textSizes.map((size, i) => (
            <button
              type="button"
              data-a11y-text={size.value}
              aria-label={size.label}
              title={size.label}
              class="flex-1 cursor-pointer rounded-xl border border-mint-100 px-2 py-1.5 font-bold leading-none text-blacktext transition-colors hover:bg-mint-50 hover:text-mint-600 aria-pressed:border-mint-400 aria-pressed:bg-mint-50 aria-pressed:text-mint-600 dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-mint-300 dark:aria-pressed:border-mint-400 dark:aria-pressed:bg-zinc-800 dark:aria-pressed:text-mint-300"
              style={`font-size:${0.7 + i * 0.2}rem`}
            >
              {size.sample}
            </button>
          ))
        }
      </div>

      {
        toggles.map((toggle) => (
          <label class="flex cursor-pointer items-center justify-between gap-3 rounded-xl px-1 py-1.5 text-xs font-medium text-blacktext transition-colors hover:text-mint-600 dark:text-zinc-300 dark:hover:text-mint-300">
            {toggle.label}
            <input
              type="checkbox"
              data-a11y-toggle={toggle.key}
              class="size-4 shrink-0 accent-mint-500 cursor-pointer"
            />
          </label>
        ))
      }

      <button
        type="button"
        data-a11y-reset
        class="mt-2 w-full cursor-pointer rounded-xl border border-mint-100 px-3 py-1.5 text-xs font-semibold text-blacktext/70 transition-colors hover:border-mint-400 hover:text-mint-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-mint-400 dark:hover:text-mint-300"
      >
        {t("a11y.reset")}
      </button>
    </div>
  </div>
</div>

<script>
  // Preferences are stored as data attributes and a CSS custom property on
  // <html>, so the styling is pure CSS. Layout.astro replays them from
  // localStorage before first paint; this script only handles changes.
  const root = document.documentElement;
  const STORE = "a11y-prefs";

  type Prefs = {
    text: string;
    underline: boolean;
    motion: boolean;
    contrast: boolean;
    spacing: boolean;
    readableFont: boolean;
    focus: boolean;
  };

  const DEFAULTS: Prefs = {
    text: "1",
    underline: false,
    motion: false,
    contrast: false,
    spacing: false,
    readableFont: false,
    focus: false,
  };

  const read = (): Prefs => {
    try {
      return { ...DEFAULTS, ...JSON.parse(localStorage.getItem(STORE) || "{}") };
    } catch {
      return { ...DEFAULTS };
    }
  };

  function apply(prefs: Prefs) {
    root.style.setProperty("--a11y-text-scale", prefs.text);
    root.dataset.a11yUnderline = prefs.underline ? "on" : "off";
    // `motion: true` means "reduce it", so the attribute is the inverse.
    root.dataset.a11yMotion = prefs.motion ? "off" : "on";
    root.dataset.a11yContrast = prefs.contrast ? "on" : "off";
    root.dataset.a11ySpacing = prefs.spacing ? "on" : "off";
    root.dataset.a11yFont = prefs.readableFont ? "readable" : "default";
    root.dataset.a11yFocus = prefs.focus ? "on" : "off";

    document.querySelectorAll<HTMLButtonElement>("[data-a11y-text]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.a11yText === prefs.text));
    });
    document.querySelectorAll<HTMLInputElement>("[data-a11y-toggle]").forEach((box) => {
      const key = box.dataset.a11yToggle as keyof Prefs;
      box.checked = prefs[key] === true;
    });

    // Reducing motion has to reach the looping project previews too, otherwise
    // the one thing actually moving on the page keeps moving.
    document.querySelectorAll<HTMLVideoElement>("video[data-lazy-preview]").forEach((video) => {
      if (!prefs.motion) return;
      video.pause();
      video.currentTime = 0;
    });
  }

  function save(prefs: Prefs) {
    try {
      localStorage.setItem(STORE, JSON.stringify(prefs));
    } catch {
      // Private mode or a full quota: the preference still applies to this page.
    }
    apply(prefs);
  }

  apply(read());

  document.querySelectorAll<HTMLButtonElement>("[data-a11y-text]").forEach((btn) => {
    btn.addEventListener("click", () => save({ ...read(), text: btn.dataset.a11yText || "1" }));
  });

  document.querySelectorAll<HTMLInputElement>("[data-a11y-toggle]").forEach((box) => {
    box.addEventListener("change", () => {
      const key = box.dataset.a11yToggle as keyof Prefs;
      save({ ...read(), [key]: box.checked });
    });
  });

  document.querySelector("[data-a11y-reset]")?.addEventListener("click", () => {
    save({ ...DEFAULTS });
  });
</script>
