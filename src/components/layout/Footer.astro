---
import Social from "../ui/Social.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";
import { getLangFromUrl, localizePath, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const [staticData] = await getCollection("staticData");
const {
  github,
  contra,
  alias,
  email,
  youtube,
  linkedin,
  emailIconName,
  contraIconName,
  youtubeIconName,
  linkedinIconName,
  githubIconName,
} = staticData.data;

const year = new Date().getFullYear();
---

<footer
  class="relative bottom-0 w-full px-4 py-8 font-medium text-blacktext dark:bg-transparent dark:border-b-2 dark:border-zinc-800 dark:text-zinc-300 max-lg:mt-3"
  role="contentinfo"
  aria-label={t("aria.footer")}
>
  <nav
    class="mx-auto flex max-w-7xl flex-row items-center justify-between gap-4 text-xl max-xl:px-6 max-sm:flex-col max-sm:pb-5"
    aria-label={t("footer.nav")}
  >
    <div
      class="relative h-6 cursor-pointer before:absolute before:left-1/2 before:top-1/2 before:h-full before:w-[40%] before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-[#50fd8f25] before:blur-3xl before:opacity-80 before:-z-1 hover:text-mint-500 transition-all [text-shadow:0_1px_2px_#000]"
    >
      <a href="/" aria-label={t("footer.home")}>
  <div class="relative h-6 cursor-pointer before:absolute before:left-1/2 before:top-1/2 before:h-full before:w-[40%] before:-translate-x-1/2 before:-translate-y-1/2 before:rounded-full before:bg-[#50fd8f25] before:blur-3xl before:opacity-80 before:-z-1 hover:text-mint-500 transition-all [text-shadow:0_1px_2px_#000] max-sm:pt-3">
    
    <Image
  src={logo}
  alt="Logo"
  height={38}
  loading="lazy"
  decoding="async"
  class="h-[38px] w-auto object-contain cursor-pointer translate-y-[-7px]"
/>


  </div>
</a>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center max-sm:py-7">
      <a
        href={github}
        class="flex items-center justify-center gap-3 text-sm font-normal italic max-sm:text-sm"
        aria-label={t("aria.footerCredit")}
        ><Icon name="code" aria-hidden="true" /> {t("footer.developedBy")} <strong
          >{alias}</strong
        > {t("footer.with")}</a
      >
      <span class="text-sm font-normal italic max-sm:text-sm">
        © {year} {alias} {t("footer.rights")}
      </span>
    </div>
    <div
      class="flex items-center justify-center gap-5"
      role="group"
      aria-label={t("footer.social")}
    >
      <Social
        link={`mailto:${email}`}
        iconName={emailIconName}
        label={`Send email to ${email}`}
      />

        <Social
        link={contra}
        iconName={contraIconName}
        label={`Visit ${alias} on Contra`}
      />

      <Social
        link={github}
        iconName={githubIconName}
        label={`Visit ${alias} on GitHub`}
      />
      <Social
        link={linkedin}
        iconName={linkedinIconName}
        label={`Visit ${alias} on LinkedIn`}
      />
    </div>
  </nav>

  <!-- Legal links sit on their own quiet line under the main row: small,
       muted, and only coloured on hover, so they are easy to find without
       competing with the logo, the credit or the social icons. -->
  <nav
    class="mx-auto mt-6 flex max-w-7xl flex-wrap items-center justify-center gap-x-3 gap-y-2 max-sm:gap-x-5 border-t border-blacktext/5 pt-5 text-xs font-normal text-blacktext/60 dark:border-zinc-800/70 dark:text-zinc-500 max-xl:px-6 max-sm:mt-0"
    aria-label={t("footer.legal")}
  >
    <a
      href={localizePath("/privacy", lang)}
      class="transition-colors hover:text-mint-600 dark:hover:text-mint-300"
    >
      {t("footer.privacy")}
    </a>
    <!-- Separators hide on phones: there the links wrap, and a dot left hanging
         at the end of a line looks like a mistake. The gap alone spaces them. -->
    <span aria-hidden="true" class="opacity-50 max-sm:hidden">·</span>
    <a
      href={localizePath("/cookies", lang)}
      class="transition-colors hover:text-mint-600 dark:hover:text-mint-300"
    >
      {t("footer.cookies")}
    </a>
    <span aria-hidden="true" class="opacity-50 max-sm:hidden">·</span>
    <button
      type="button"
      data-consent-open
      class="cursor-pointer transition-colors hover:text-mint-600 dark:hover:text-mint-300"
    >
      {t("footer.cookieSettings")}
    </button>
  </nav>
</footer>
