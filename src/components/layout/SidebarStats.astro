---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const languages = [t("sidebar.langSpanish"), t("sidebar.langEnglish")];

// The traits clients and hiring managers actually screen for, not tool skills.
const softSkills = [
  t("sidebar.skill1"),
  t("sidebar.skill2"),
  t("sidebar.skill3"),
  t("sidebar.skill4"),
  t("sidebar.skill5"),
  t("sidebar.skill6"),
];

const labProgress = [
  { name: t("sidebar.labPersonal"), value: 60 },
  { name: t("sidebar.labGames"), value: 50 },
];

const headingCls =
  "dark:text-zinc-400 text-blacktext/90 font-black tracking-wide text-sm uppercase";
const bulletTextCls =
  "text-xs font-semibold dark:text-neutral-300 text-neutral-600 leading-5";
---

<div class="max-lg:hidden">
  <div
    id="sidebar-stats"
    class="sticky w-64 mt-8 rounded-2xl dark:border-0 border border-neutral-100 bg-white dark:bg-transparent top-14 max-h-[calc(100svh-3.5rem)] overflow-y-auto overflow-x-hidden px-5 pt-8 pb-12"
  >
    <div class="flex flex-col gap-6">

      <!-- LANGUAGES -->
      <div class="flex flex-col gap-3">
        <h3 class={headingCls}>{t("sidebar.languages")}</h3>
        <ul class="flex flex-col gap-2">
          {
            languages.map((language) => (
              <li class="flex items-start gap-2.5">
                <span
                  class="mt-1.5 size-1.5 shrink-0 rotate-45 bg-riptide-400"
                  aria-hidden="true"
                />
                <span class={bulletTextCls}>{language}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <hr class="dark:border-neutral-700 border-neutral-200" />

      <!-- SOFT SKILLS -->
      <div class="flex flex-col gap-3">
        <h3 class={headingCls}>{t("sidebar.softSkills")}</h3>
        <ul class="flex flex-col gap-2">
          {
            softSkills.map((skill) => (
              <li class="flex items-start gap-2.5">
                <span
                  class="mt-1.5 size-1.5 shrink-0 rotate-45 bg-riptide-400"
                  aria-hidden="true"
                />
                <span class={bulletTextCls}>{skill}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <hr class="dark:border-neutral-700 border-neutral-200" />

      <!-- LAB PROGRESS -->
      <div class="flex flex-col gap-3">
        <h3 class={headingCls}>{t("sidebar.labProgress")}</h3>
        <div class="flex flex-col gap-4">
          {
            labProgress.map((item) => (
              <div class="flex flex-col gap-1">
                <div class="flex justify-between items-center">
                  <span class="text-xs font-semibold dark:text-neutral-300 text-neutral-600">
                    {item.name}
                  </span>
                  <span class="text-xs font-bold text-riptide-400 dark:text-riptide-300">
                    {item.value}%
                  </span>
                </div>
                <div class="w-full h-2 rounded-full bg-neutral-200 dark:bg-zinc-800 overflow-hidden">
                  <div
                    class="progress-bar h-full rounded-full bg-linear-to-r from-mint-500 to-riptide-400 relative overflow-hidden"
                    style={`width: ${item.value}%`}
                  >
                    <div class="absolute inset-0 bg-linear-to-r from-transparent via-white/20 to-transparent animate-shimmer" />
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  @keyframes shimmer {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(200%); }
  }
  .animate-shimmer {
    animation: shimmer 2s infinite;
  }
</style>
