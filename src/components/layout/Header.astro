---
import Navigation from "./Navigation.astro";
import ThemeIcon from "../ui/ThemeIcon.astro";
import Social from "../ui/Social.astro";
import LanguageSwitcher from "../ui/LanguageSwitcher.astro";
import AccessibilityMenu from "../ui/AccessibilityMenu.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import logo from "../../assets/logo.png";

const [staticData] = await getCollection("staticData");
const { github, githubIconName, linkedin, linkedinIconName, contra, contraIconName } = staticData.data;

// Home and About carry their own sub-menus, so the same set works on every route.
const navItems = ["home", "about", "blog", "reviews", "contact"];

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<header
  role="banner"
  aria-label={t("aria.mainNav")}
  class="sticky top-0 z-50 w-full p-4 font-medium text-blacktext dark:text-zinc-300 dark:bg-[#0E0E11]/80 dark:border-b dark:border-zinc-800 bg-white/90 backdrop-blur-xs dark:backdrop-blur-xs max-md:z-50 max-md:px-0 transition-all"
>
  <!-- Tighter padding and gaps under md: the logo alone takes half a 360px
       screen, so the controls beside it have very little room to work with. -->
  <div class="relative mx-auto flex max-w-7xl flex-row items-center justify-between max-xl:px-6 max-lg:px-4 max-md:px-3">
  
    <!-- <img 
  src="/logo.png" 
  height="24"
  style="width: auto; height: 36px; object-fit: contain;"
  alt="Logo" 
/> -->

<Image
  src={logo}
  alt="Logo"
  height={50}
  loading="eager"
  decoding="async"
  class="h-[35px] max-lg:h-6 w-auto object-contain"
/>

    <Navigation items={navItems} />

    <div class="flex items-center gap-5 max-lg:gap-3 max-md:gap-2 text-xl">
      <AccessibilityMenu />
      <LanguageSwitcher />
      <!-- Held back to lg: at 768px the desktop nav is already competing with
           the logo and the two menus, and the social row tipped it over. -->
      <div class="max-lg:hidden flex items-center justify-center gap-5" role="group">
        <Social link={contra} iconName={contraIconName} />
        <Social link={github} iconName={githubIconName} />
        <Social link={linkedin} iconName={linkedinIconName} />
      </div>
      <ThemeIcon />
      <button
        class="hamburger"
        aria-label={t("nav.openMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="bars" class="hamburger-icon bars-icon" aria-hidden="true" />
        <Icon name="xmark" class="hamburger-icon xmark-icon" aria-hidden="true" />
      </button>
    </div>
  </div>
</header>

<script>
  const hamburger = document.querySelector(".hamburger");
  const nav = document.getElementById("mobile-menu");

  if (hamburger && nav) {
    hamburger.addEventListener("click", () => {
      const isOpen = nav.style.display === "flex";
      nav.style.display = isOpen ? "none" : "flex";
      nav.style.flexDirection = "column";
      nav.style.alignItems = "center";
      nav.style.textAlign = "center";
      nav.style.position = "absolute";
      nav.style.top = "100%";
      nav.style.left = "0";
      nav.style.width = "100%";
      nav.style.zIndex = "50";
      nav.style.padding = "1rem 0";
      nav.style.backdropFilter = "blur(12px)";
      nav.style.borderBottom = "1px solid rgba(13,188,130,0.2)";

      const isDark = document.documentElement.classList.contains("dark");
      nav.style.background = isDark
        ? "rgba(14,14,17,0.95)"
        : "rgba(255,255,255,0.95)";
    });
  }
</script>