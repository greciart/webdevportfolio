---
// Rendered once per page. Every MasonryGallery item on the page hooks into it
// through the `data-lb-*` attributes and pages within its own `data-lb-group`.
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const t = useTranslations(getLangFromUrl(Astro.url));
---

<div
  id="gallery-lightbox"
  class="fixed inset-0 z-100 hidden items-center justify-center bg-black/85 p-6 backdrop-blur-md max-sm:p-3"
  role="dialog"
  aria-modal="true"
  aria-label={t("aria.lightbox")}
>
  <button
    type="button"
    data-lb-close
    class="absolute right-5 top-5 z-10 flex size-11 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/80 text-xl font-bold text-white transition-colors hover:border-mint-400 hover:text-mint-300"
    aria-label={t("aria.lightboxClose")}
  >
    ✕
  </button>

  <button
    type="button"
    data-lb-prev
    class="absolute left-5 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/80 text-xl font-bold text-white transition-colors hover:border-mint-400 hover:text-mint-300 disabled:pointer-events-none disabled:opacity-25 max-sm:left-2"
    aria-label={t("aria.prevImage")}
  >
    ‹
  </button>

  <button
    type="button"
    data-lb-next
    class="absolute right-5 top-1/2 z-10 flex size-11 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-700 bg-zinc-900/80 text-xl font-bold text-white transition-colors hover:border-mint-400 hover:text-mint-300 disabled:pointer-events-none disabled:opacity-25 max-sm:right-2"
    aria-label={t("aria.nextImage")}
  >
    ›
  </button>

  <figure class="flex max-h-full max-w-6xl flex-col items-center gap-4" data-lb-stage>
    <img
      data-lb-image
      src=""
      alt=""
      class="max-h-[76vh] w-auto max-w-full rounded-2xl object-contain shadow-2xl"
    />
    <figcaption class="flex flex-col items-center gap-3 text-center">
      <p data-lb-title class="text-sm font-bold text-white max-sm:text-xs"></p>
      <div class="flex items-center gap-4">
        <span data-lb-counter class="text-xs font-medium text-zinc-400"></span>
        <a
          data-lb-link
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-full bg-linear-to-r from-riptide-400 to-mint-500 px-5 py-2 text-xs font-semibold text-blacktext transition-transform hover:scale-105"
        >
          {t("gallery.viewCase")} ↗
        </a>
      </div>
    </figcaption>
  </figure>
</div>

<script>
  type Slide = {
    src: string;
    alt: string;
    title: string;
    href: string;
  };

  const root = document.getElementById("gallery-lightbox");
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("[data-lb]"),
  );

  if (root && triggers.length > 0) {
    const image = root.querySelector<HTMLImageElement>("[data-lb-image]")!;
    const titleEl = root.querySelector<HTMLElement>("[data-lb-title]")!;
    const counter = root.querySelector<HTMLElement>("[data-lb-counter]")!;
    const link = root.querySelector<HTMLAnchorElement>("[data-lb-link]")!;
    const prevBtn = root.querySelector<HTMLButtonElement>("[data-lb-prev]")!;
    const nextBtn = root.querySelector<HTMLButtonElement>("[data-lb-next]")!;
    const closeBtn = root.querySelector<HTMLButtonElement>("[data-lb-close]")!;

    // Bucket every trigger by its gallery so arrows never cross sections.
    const groups = new Map<string, Slide[]>();
    triggers.forEach((trigger) => {
      const group = trigger.dataset.lbGroup ?? "default";
      if (!groups.has(group)) groups.set(group, []);
      groups.get(group)!.push({
        src: trigger.dataset.lbSrc ?? "",
        alt: trigger.dataset.lbAlt ?? "",
        title: trigger.dataset.lbTitle ?? "",
        href: trigger.dataset.lbHref ?? "",
      });
    });

    let slides: Slide[] = [];
    let index = 0;
    let lastFocused: HTMLElement | null = null;

    function render() {
      const slide = slides[index];
      if (!slide) return;
      image.src = slide.src;
      image.alt = slide.alt;
      titleEl.textContent = slide.title;
      counter.textContent = `${index + 1} / ${slides.length}`;

      if (slide.href) {
        link.href = slide.href;
        link.classList.remove("hidden");
        link.classList.add("inline-flex");
      } else {
        link.classList.add("hidden");
        link.classList.remove("inline-flex");
      }

      const single = slides.length < 2;
      prevBtn.disabled = single || index === 0;
      nextBtn.disabled = single || index === slides.length - 1;
    }

    function open(group: string, startIndex: number, origin: HTMLElement) {
      slides = groups.get(group) ?? [];
      if (slides.length === 0) return;
      index = Math.min(Math.max(startIndex, 0), slides.length - 1);
      lastFocused = origin;
      root.classList.remove("hidden");
      root.classList.add("flex");
      document.body.style.overflow = "hidden";
      render();
      closeBtn.focus();
    }

    function close() {
      root.classList.add("hidden");
      root.classList.remove("flex");
      document.body.style.overflow = "";
      image.src = "";
      lastFocused?.focus();
      lastFocused = null;
    }

    function step(delta: number) {
      const next = index + delta;
      if (next < 0 || next >= slides.length) return;
      index = next;
      render();
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        open(
          trigger.dataset.lbGroup ?? "default",
          Number(trigger.dataset.lbIndex ?? 0),
          trigger,
        );
      });
    });

    closeBtn.addEventListener("click", close);
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));

    // Backdrop click closes; clicks inside the figure must not bubble out.
    root.addEventListener("click", (event) => {
      if (event.target === root) close();
    });

    document.addEventListener("keydown", (event) => {
      if (root.classList.contains("hidden")) return;
      if (event.key === "Escape") close();
      if (event.key === "ArrowLeft") step(-1);
      if (event.key === "ArrowRight") step(1);
    });
  }
</script>
