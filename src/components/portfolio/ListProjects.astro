---
import Project from "./Project.astro";
import Heading from "../ui/Heading.astro";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, localizePath, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
import { getSortedProjects } from "../../i18n/projects";

const allPosts = await getSortedProjects(lang);
const p = (path) => localizePath(path, lang);
---

<section
  class="bg-linear-to-t dark:from-[#0e0e10] from-white from-50% to-transparent to-100% scroll-m-16 relative pt-8 pb-32 max-2xl:px-8 max-md:pt-4"
  id="projects"
>
  <div data-reveal="blur-up" class="mx-auto max-w-7xl py-8">
    <div class="flex gap-4 items-center justify-center text-center">
      <Icon class="text-3xl dark:text-white text-blacktext" name="code" />
      <Heading text={t("projects.title")} textGradient={t("projects.titleAccent")} level={2} />
    </div>

<p
  class="z-2 text-center mx-auto text-base max-w-2xl dark:text-gray-200 text-blacktext my-6 leading-relaxed font-normal"
>


      {t("projects.copy")}
    </p>

    <!-- Pricing sits here on purpose: someone who has just read about the work
         is the person most likely to want a number for it. -->
    <div data-reveal="fade" class="flex flex-wrap items-center justify-center gap-3">
      <span class="text-sm max-xl:text-xs font-normal text-blacktext/70 dark:text-gray-400">
        {t("projects.packagesLead")}
      </span>
      <a
        href={p("/packages")}
        class="group/pkg z-2 inline-flex items-center gap-1.5 rounded-full border border-mint-400/40 bg-white/60 px-4 py-2 text-sm max-xl:text-xs font-semibold text-mint-700 transition-all hover:border-mint-500 hover:bg-white dark:border-mint-400/30 dark:bg-zinc-900/50 dark:text-mint-200 dark:hover:border-mint-300 dark:hover:bg-zinc-900"
      >
        {t("projects.packagesLink")}
        <span
          class="transition-transform duration-300 group-hover/pkg:translate-x-0.5"
          aria-hidden="true">→</span
        >
      </a>
    </div>

    <slot />
  </div>

<div
  id="containerProjects"
  data-reveal-stagger="scale"
  class="mx-auto max-w-7xl grid grid-cols-3 max-lg:grid-cols-2 max-md:grid-cols-1 gap-5 p-2 py-4 max-h-[1400px] overflow-hidden transition-[max-height] duration-700 ease-in-out"
>
{
  allPosts.map((post) => (
    <Project
      url={p(`/portfolio/projects/${post.slug}`)}
      title={post.data.title}
      description={post.data.description}
      date={post.data.pubDate}
      languages={post.data.languages}
      image={post.data.image}
      video={post.data.video}
    />
  ))
}
  </div>

  <div
    id="moreProjects"
    class="absolute bottom-0 left-0 w-full flex justify-center text-center bg-linear-to-t from-[#FBFEFD] dark:from-[#0e0e10] from-55% to-transparent to-100% pb-30 pt-52"
  >
    <button
      class="absolute font-bold cursor-pointer text-mint-400 dark:text-mint-100 hover:text-mint-500 dark:hover:text-mint-300 transition-all"
    >
      {t("projects.viewMore")}
    </button>
  </div>
</section>

<script>
  document.querySelector("#moreProjects")?.addEventListener("click", () => {
    const container = document.querySelector("#containerProjects") as HTMLElement;
    const moreProjectsBtn = document.querySelector("#moreProjects");

    if (container && moreProjectsBtn) {
      const fullHeight = container.scrollHeight; // 1️⃣ leer primero
      container.style.maxHeight = fullHeight + "px"; // 2️⃣ modificar después
      setTimeout(() => {
        moreProjectsBtn.classList.add("hidden");
      }, 700);
    }
  });
</script>
