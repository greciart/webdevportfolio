---
// For readers with a question about the post. The subject is the post title, so
// the reply lands already knowing what it is about.
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

interface Props {
  title: string;
}

const { title }: Props = Astro.props;

const t = useTranslations(getLangFromUrl(Astro.url));

const [staticData] = await getCollection("staticData");
const { email } = staticData.data;

const href = `mailto:${email}?subject=${encodeURIComponent(title)}`;
---

<div class="flex justify-center">
  <a
    href={href}
    class="inline-flex items-center gap-2 rounded-full border border-mint-200 bg-white/70 px-5 py-2.5 text-xs font-semibold text-blacktext transition-all duration-300 hover:-translate-y-0.5 hover:border-mint-400 hover:shadow-lg hover:shadow-mint-500/20 dark:border-zinc-700 dark:bg-zinc-900/60 dark:text-mint-50 dark:hover:border-mint-400"
  >
    <Icon name="envelope" class="size-4 shrink-0" aria-hidden="true" />
    {t("share.replyEmail")}
  </a>
</div>
