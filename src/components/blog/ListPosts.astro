---
import BlogPost from "./BlogPost.astro";
import Heading from "../ui/Heading.astro";
import { getLangFromUrl, localizePath, useTranslations } from "../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Prop to determine whether to exclude the latest post or a specific post
export interface Props {
  excludeLatest?: boolean;
  currentPostUrl?: string;
  all?: boolean;
}

const { excludeLatest = false, currentPostUrl = "", all = false } = Astro.props;

import { getPosts } from "../../i18n/posts";
const allPostsByLang = getPosts(lang);
const allPosts: any[] = allPostsByLang;
// Sort by date in descending order (newest first)
allPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.pubDate).getTime();
  const dateB = new Date(b.frontmatter.pubDate).getTime();
  return dateB - dateA;
});

// Filter posts according to props
let postsToShow = allPosts;

if (currentPostUrl) {
  const norm = (u: string) => u.replace(/\/$/, "");
  const current = allPosts.find((post) => post.url && norm(post.url) === norm(currentPostUrl));
  postsToShow = postsToShow.filter((post) => post.url && norm(post.url) !== norm(currentPostUrl));

  // Related posts instead of "the 4 newest". With the newest list, every
  // article linked to the same four, and older posts were only reachable from
  // /blog/posts/; Google read that as "not important" and left them in
  // "Crawled - currently not indexed". Ranking by shared tags/techs spreads the
  // internal links across the whole archive. Ties keep newest-first (the sort
  // above is stable).
  if (current) {
    const topics = new Set([
      ...(current.frontmatter.tags ?? []),
      ...(current.frontmatter.languages ?? []),
    ]);
    const score = (post: any) =>
      [...(post.frontmatter.tags ?? []), ...(post.frontmatter.languages ?? [])].filter((x) =>
        topics.has(x),
      ).length;
    postsToShow = [...postsToShow].sort((a, b) => score(b) - score(a));
  }
} else if (excludeLatest) {
  // If no specific URL but want to exclude the latest
  postsToShow = postsToShow.slice(1);
}

// Limit to 4 posts if all is false
if (!all) {
  postsToShow = postsToShow.slice(0, 4);
}

const uiLang = getLangFromUrl(Astro.url);
const p = (path) => localizePath(path, uiLang);
---

<section
  class="py-8 max-lg:px-4 max-md:px-8 max-sm:px-0 max-md:py-4 max-w-4xl mx-auto"
>
  {
    all && (
      <div data-reveal="blur" class="flex gap-4 pb-6 items-center text-center justify-center">
        <Heading text={t("blog.allPosts")} textGradient={t("blog.allPostsAccent")} level={2} />
      </div>
    )
  }

  <div data-reveal-stagger="up" class="flex flex-col gap-8 w-full mx-auto">
    {
      postsToShow.map((post) => (
        <BlogPost
          url={post.url}
          title={post.frontmatter.title}
          date={post.frontmatter.pubDate}
          tags={post.frontmatter.tags}
          languages={post.frontmatter.languages}
          image={post.frontmatter.image}
        />
      ))
    }
  </div>
  {
    !all && (
      <div id="morePosts" class="w-full flex justify-center text-center my-12">
        <a
          href={p("/blog/posts/")}
          class="font-bold cursor-pointer text-mint-400 dark:text-mint-100 hover:text-mint-500 dark:hover:text-mint-300 transition-all"
        >
          {t("blog.viewAll")}
        </a>
      </div>
    )
  }
</section>
